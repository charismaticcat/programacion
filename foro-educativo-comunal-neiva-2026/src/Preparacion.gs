  "141001001259": {
    "fileId": "1i3hVwQgYfe-5Ae8DW_DzSktKLJOy0byv",
    "institución": "JUAN DE CABRERA",
    "p1": "La IE JUAN DE CABRERA logró el avance más consolidado en la actualización curricular y el tránsito hacia el modelo pedagógico constructivista, con reestructuración del PEI y el paso de cuatro a tres periodos académicos. Se destaca el fortalecimiento de proyectos transversales como el PRAE, educación para la sexualidad, educación vial, bilingüismo y experiencias significativas como Aires de San Juan, así como avances en inclusión mediante los PIAR. Persisten dificultades por escasez de recursos económicos, falta de personal de apoyo especializado y limitaciones administrativas.",
    "p2": "La IE JUAN DE CABRERA no ha logrado avanzar en la implementación efectiva de los grados de prejardín y jardín pese a haber realizado la oferta educativa, debido principalmente a la insuficiente demanda de la población, ya que las familias prefieren mantener a los niños en hogares infantiles o programas de bienestar familiar. Se reportan avances parciales como el ajuste de planes de área, capacitaciones docentes y el fortalecimiento del grado Transición, reconociendo que la parálisis obedece a condiciones administrativas y presupuestales externas a la institución.",
    "p3": "La IE JUAN DE CABRERA considera que sus currículos sí son pertinentes con las realidades territoriales, pues se construyen a partir de los estándares del Ministerio de Educación pero se adaptan progresivamente incorporando emprendimiento, educación financiera e identidad cultural huilense. Reconoce que el proceso no está terminado y que es necesario fortalecer la orientación vocacional y la proyección profesional de los estudiantes.",
    "p4": "La IE JUAN DE CABRERA describe cuatro acciones: la realización de diagnósticos de caracterización de la población estudiantil y del contexto; el fomento y transversalización de proyectos pedagógicos como el PRAE, educación para la sexualidad y emprendimiento escolar; la adopción del modelo pedagógico constructivista con elaboración de PIAR para estudiantes con necesidades educativas particulares; y la vinculación de las problemáticas del contexto en la planeación de aula mediante debate entre equipos docentes.",
    "p5": "La IE JUAN DE CABRERA conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, el Equipo de Preescolar, comités de área, el Equipo de Educación Inclusiva y una Mesa de Diálogo Currículo-Comunidad. La articulación se logra mediante reuniones periódicas de los comités de área y proyectos, donde se comparten diagnósticos y se debaten estrategias. El seguimiento se realiza mediante auditoría curricular frente a los DBA, análisis de Pruebas Saber, matrices de seguimiento curricular y autoevaluación institucional anual.",
    "p6": "La IE JUAN DE CABRERA reconoce que existen instancias formales de participación democrática como el Consejo Directivo, el Consejo Académico, el Consejo de Padres y el Consejo Estudiantil, pero señala que la participación es todavía limitada en la práctica, pues algunas decisiones se toman de manera impositiva por directivos docentes o el equipo de gestión. Entre sus acciones destaca el fortalecimiento de la escuela de padres, la realización de reuniones periódicas del Consejo de Padres y del gobierno escolar, y comisiones de evaluación por período con jornadas de atención a padres. El seguimiento se realiza mediante reuniones periódicas de los entes de gobierno escolar, elecciones estudiantiles, autoevaluación institucional anual e informes de gestión del Consejo Directivo."
  },
  "141001001321": {
    "fileId": "1T1hkTViQXpolY3_U0rnJVrV-Xghf2gfK",
    "institución": "RICARDO BORRERO ALVAREZ",
    "p1": "La IE RICARDO BORRERO ALVAREZ registra progresos en la construcción de un PEI más flexible, contextualizado e incluyente, apoyado en el Diseño Universal para el Aprendizaje y los Planes Individuales de Ajustes Razonables, junto con el fortalecimiento de proyectos transversales y la articulación con instituciones públicas y privadas. Destaca experiencias como el proyecto de matemática verde, orientado a la recolección de reciclaje para adquirir herramientas tecnológicas, y el centro de interés voces Ricardistas. Persisten problemas de infraestructura y salubridad en algunas sedes, deficiencias en el Programa de Alimentación Escolar y en el transporte escolar, y la necesidad de reforzar la corresponsabilidad familiar y superar brechas tecnológicas.",
    "p2": "La IE RICARDO BORRERO ALVAREZ señala que la sede Jardín Infantil Nacional constituye el pilar de la atención a la primera infancia, con un crecimiento progresivo apalancado en la política De Cero a Siempre: la oferta pasó de dos grupos de jardín en 2024 a incluir prejardín en 2025 y, en 2026, prejardín, jardín y cuatro grupos de transición. Entre los retos identifica ampliar la cobertura en la jornada de la mañana, renovar la red eléctrica obsoleta, mejorar el parque infantil y la ludoteca, y fortalecer el acompañamiento docente, además de haber reestructurado el currículo de preescolar conforme a los nuevos lineamientos que ya no se evalúan por DBA sino por propósitos de desarrollo.",
    "p3": "La IE RICARDO BORRERO ALVAREZ advierte que persiste una estructura curricular fragmentada y rígida por asignaturas, por lo que considera imperativo avanzar hacia una articulación interdisciplinar que priorice competencias para la vida y el cuidado del territorio. Señala también la necesidad de una inducción institucional formal para docentes provisionales, y reconoce que la pertinencia en la media se materializa mediante convenios con el SENA y la Universidad de Navarra, proponiendo una resignificación curricular arraigada en la biodiversidad y la cultura de Neiva y el Huila.",
    "p4": "La IE RICARDO BORRERO ALVAREZ reporta cuatro acciones para articular el currículo con la comunidad: la planeación de simulacros sistematizados para las Pruebas Saber en articulación con entidades externas; la asignación de roles a estudiantes como líderes y guardianes ambientales, de convivencia y de TIC, junto con espacios de autocapacitación docente; reuniones de área periódicas para ajustar los planes de estudio y desarrollar proyectos interdisciplinares; y la promoción de actividades institucionales lúdicas, científicas y artísticas que congregan a toda la comunidad.",
    "p5": "La IE RICARDO BORRERO ALVAREZ conformó equipos como el Consejo Académico, el Consejo Directivo, los comités de área, el Equipo de Educación Inclusiva/NEE, el Consejo Estudiantil, el Consejo de Padres y la Personería Estudiantil, que se articulan mediante diálogo presencial y reuniones periódicas, con el Consejo Académico liderando la transformación curricular y los comités de área diseñando las propuestas de aula. La comunicación se canaliza mediante circulares de rectoría y WhatsApp, aunque se advierte falta de tiempo operativo para optimizar el seguimiento, que se apoya en matrices de seguimiento curricular, actas, portafolios docentes y la plataforma JIGRA.",
    "p6": "La IE RICARDO BORRERO ALVAREZ cuenta con espacios formales de diálogo democrático como el Consejo Directivo, Académico, de Padres y Estudiantil, pero reconoce que la participación suele limitarse a elegir representantes o asistir a citaciones informativas, mientras las decisiones clave se centralizan en el equipo de gestión. Entre las acciones implementadas están las elecciones democráticas para el Gobierno Escolar, las asambleas y comisiones con padres de familia para retroalimentación académica, y la aplicación de encuestas de caracterización socioeconómica en el marco de la recontextualización del PEI. El seguimiento a estas estrategias se realiza mediante reuniones periódicas, elecciones estudiantiles y docentes, autoevaluación institucional, el Plan de Mejoramiento Institucional y el seguimiento al clima escolar."
  },
  "141001001763": {
    "fileId": "1GhIysI-040rHeIFlKLxUPoYf-QCL_RKv",
    "institución": "AGUSTIN CODAZZI",
    "p1": "La IE AGUSTIN CODAZZI reconoce avances significativos frente a los retos del FEM 2025, con progresos en la atención integral de estudiantes, el fortalecimiento del restaurante escolar y la alimentación escolar, asi como en la educación inicial en la sede El Rosario y en la sede central. Destaca la resignificación del modelo pedagógico, el uso de herramientas digitales, la formación docente y la articulación con el SENA. También reconoce avances en participación y convivencia a través del Gobierno Escolar y los proyectos de democracia. No obstante, identifica retos pendientes como las limitaciones de recursos, infraestructura y conectividad, y la necesidad de fortalecer la participación de familias y estudiantes y los mecanismos de seguimiento.",
    "p2": "La IE AGUSTIN CODAZZI reporta avances en la implementación de la educación inicial, especialmente en la sede El Rosario, donde se atiende el grado Jardín con ambientes diferenciados, y en la sede central, donde también se atiende a niños de Jardín. Señala el fortalecimiento de las capacidades docentes y la importancia de vincular a las familias y de articular la educación inicial con Transición y básica primaria. Entre los retos pendientes menciona mejorar la infraestructura en sedes como Emaya, ampliar cobertura y matrícula, y fortalecer la promoción de la oferta de educación inicial.",
    "p3": "La IE AGUSTIN CODAZZI considera que su currículo ha avanzado hacia una mayor pertinencia y contextualización, en coherencia con el PEI y el enfoque humanista, con avances en inclusión, atención a la diversidad y articulación con el SENA. Sin embargo, señala que es necesario seguir fortaleciendo la relación entre el currículo y las realidades sociales, culturales, ambientales y productivas del territorio mediante trabajo interdisciplinario y mayor participación de estudiantes, familias y comunidad.",
    "p4": "La IE AGUSTIN CODAZZI describe cinco acciones para articular el currículo con la comunidad: actualizar los planes de area y aula incorporando situaciones reales del entorno; generar espacios de diálogo y construcción colectiva con docentes, estudiantes y familias; establecer procesos periódicos de revisión y ajuste curricular con base en el PEI y los resultados de evaluación; fortalecer los proyectos pedagógicos transversales e interdisciplinarios en alianza con entidades externas; e impulsar estrategias de permanencia y proyección de los estudiantes mediante centros de interés y la articulación con el SENA.",
    "p5": "La IE AGUSTIN CODAZZI conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, el Equipo de Preescolar, los comités de area, el Equipo de Educación Inclusiva/NEE, el Consejo Estudiantil, el Consejo de Padres y la Personería Estudiantil, entre otros. Estos equipos se articulan mediante reuniones en jornadas pedagógicas, comités y órganos colegiados, con el Consejo Académico orientando lo curricular, aunque reconoce que aún existe fragmentación y se requiere mayor coordinación. El seguimiento se realiza mediante el análisis de resultados de Pruebas Saber e ICFES, matrices de seguimiento curricular, actas de reunión, plataformas de gestión académica y la autoevaluación institucional anual, entre otros mecanismos.",
    "p6": "La IE AGUSTIN CODAZZI considera que existe una base participativa y democrática expresada en los órganos del Gobierno Escolar y la construcción del PEI, aunque reconoce una brecha entre los mecanismos formales y la incidencia efectiva de los actores, por lo que busca ampliar espacios de escucha y seguimiento. Entre sus acciones menciona fortalecer el Gobierno Escolar y la participación estudiantil mediante el Proyecto de Democracia, promover la Escuela de Padres, usar redes sociales y canales digitales para la comunicación, y abrir espacios de consulta para actualizar el SIEE y el Manual de Convivencia. Los equipos conformados incluyen el Gobierno Escolar, el Consejo Directivo, el Consejo Académico, el Consejo Estudiantil, la Personería y Contraloría Estudiantil y el Comité Escolar de Convivencia, entre otros, y el seguimiento se garantiza mediante reuniones periódicas, elecciones estudiantiles, la autoevaluación institucional y la actualización permanente del PEI."
  },
  "141001002247": {
    "fileId": "1R0em1QDI_XjHh5LOoWxCOkXkeWTlrxiI",
    "institución": "ESCUELA NORMAL SUPERIOR",
    "p1": "La IE ESCUELA NORMAL SUPERIOR alcanzó avances significativos en la construcción de una educación pertinente y contextualizada, fortaleciendo los Proyectos Pedagógicos de Aula (PPA) que parten de las necesidades de estudiantes y comunidades. Se destacan logros en educación inclusiva (PIAR, intérpretes de Lengua de Señas), educación ambiental (experiencias con el río Las Ceibas y la quebrada La Cabuya), uso pedagógico de las TIC y enfoques de género e interculturalidad. Sin embargo persisten desafíos estructurales de infraestructura, conectividad y personal de apoyo especialmente en sedes rurales, por lo que el reto es consolidar los avances mediante mayor articulación entre áreas, sedes y niveles.",
    "p2": "La IE ESCUELA NORMAL SUPERIOR avanzó de forma importante en la implementación de Prejardín y Jardín, integrando desde 2026 la educación inicial formalmente a su misión institucional. Amplió la oferta en la sede Las Brisas y en sedes rurales como Santa Helena, Platanillal, Los Cauchos y Pueblo Nuevo, atendiendo alrededor de 32 niños de 3 y 4 años. Avanza en la resignificación del plan de estudios de preescolar y en la construcción de un perfil de Estudiante Normalista desde primera infancia. No obstante persisten dificultades de disponibilidad docente, aulas multigrado e infraestructura entre sedes.",
    "p3": "La IE ESCUELA NORMAL SUPERIOR considera que sus currículos avanzan hacia la pertinencia territorial, apoyándose en los Proyectos Pedagógicos de Aula, la lectura y caracterización del contexto y el reconocimiento de la diversidad de sedes rurales, urbanas, comunidad sorda y oyente. Destaca el campo transversal de Ciudadanía, inclusión y socioemocionalidad y los principios de la Pedagogía Crítica. Como reto plantea seguir actualizando el PEI, en especial su misión y política de calidad, para responder a la diversidad de poblaciones y contextos.",
    "p4": "La IE ESCUELA NORMAL SUPERIOR describe tres acciones principales para articular el currículo con la comunidad: el desarrollo de los Proyectos Pedagógicos de Aula que parten de las necesidades y problemáticas reales del territorio; la lectura de contexto y caracterización estudiantil que convierte las condiciones sociales y culturales en referente de planeación; y los foros y espacios de socialización como el Foro Escuela de Vida, que permite compartir experiencias entre sedes.",
    "p5": "La IE ESCUELA NORMAL SUPERIOR cuenta con una amplia estructura de equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, equipos por nivel (Preescolar, Primaria, Secundaria y Media), comités de área, el equipo de Educación Inclusiva y el Programa de Formación Complementaria. Estos se articulan mediante planeación conjunta, diálogo pedagógico y el Foro Escuela de Vida, aunque persisten dificultades de conexión entre sedes y niveles. El seguimiento se realiza mediante el Foro anual, el Consejo Académico, matrices de seguimiento curricular, autoevaluación institucional y reportes al MEN, aunque se reconoce la necesidad de un sistema más sistemático y participativo.",
    "p6": "La IE ESCUELA NORMAL SUPERIOR cuenta con una amplia estructura formal para la participación democrática (Gobierno Escolar, Consejo Directivo, Consejo Académico, Consejo de Padres, Comité de Convivencia), aunque reconoce que la existencia de espacios formales no garantiza una participación con incidencia real, por lo que su reto es avanzar hacia una participación más incidente. Entre sus acciones destaca el funcionamiento del Gobierno Escolar, los Proyectos Pedagógicos de Aula, la Escuela de Padres y los foros institucionales de socialización. Los equipos que lideran estas estrategias incluyen el Gobierno Escolar, el Consejo Directivo, el Consejo Académico, el Consejo Estudiantil, el Personero y Contralor Estudiantil y el Consejo de Padres, con seguimiento mediante actas, autoevaluación institucional anual (Guía 34) y el Plan de Mejoramiento Institucional."
  },
  "141001002557": {
    "fileId": "1_MmdPEH7896Mvuv5Yw9q2XpFXjWGQziW",
    "institución": "ANGEL MARIA PAREDES",
    "p1": "La IE ANGEL MARIA PAREDES reconoce avances desde el FEM 2025 en la ampliación de la educación inicial (Prejardín, Jardín y Transición), en el énfasis de Emprendimiento y Gestión de Proyectos y en la contextualización curricular, con un 77,1% de los consultados en la Mesa 2 considerando pertinente el currículo. También señala progresos en participación democrática, educación ambiental, inclusión y convivencia, a través de proyectos pedagógicos, ferias de emprendimiento y jornadas ambientales. Persisten dificultades de infraestructura, dotación, conectividad y falta de personal para el acompañamiento socioemocional e inclusivo, así como para lograr una participación familiar sostenida. El reto pendiente es pasar de acciones puntuales a procesos institucionales sostenibles, con mayor articulación entre currículo y territorio y una participación con incidencia real en las decisiones.",
    "p2": "La IE ANGEL MARIA PAREDES considera la implementación de Jardín y Prejardín uno de sus avances más significativos, con transformaciones pedagógicas y organizativas, docentes comprometidas, aulas, mobiliario y alianzas externas, además del paso de alimentación industrializada a preparación in situ. Sin embargo, los recursos disponibles siguen siendo insuficientes: solo el 27,1% de los consultados los consideró suficientes y oportunos, frente a un 51% que los calificó como insuficientes o parcialmente suficientes. Persisten necesidades de mantenimiento de baños, materiales didácticos y tecnológicos, y preocupa la sostenibilidad de la matrícula, en especial en la jornada de la tarde. El reto es consolidar ambientes, dotación y acompañamiento familiar con financiación pública suficiente y equitativa.",
    "p3": "La IE ANGEL MARIA PAREDES afirma que su currículo ha avanzado en pertinencia frente a las realidades sociales, culturales, productivas y ambientales del territorio, con un 77,1% de 70 participantes consultados calificándolo como pertinente. Destaca proyectos sobre problemáticas del entorno, historia y proyecto de vida, así como el énfasis en Emprendimiento y Gestión de Proyectos, la Feria de Emprendimiento y el PRAE. Reconoce la necesidad de profundizar la incorporación de saberes ancestrales y regionales, y de fortalecer la articulación entre áreas y la sistematización de experiencias. El desafío es que el territorio sea una fuente permanente y transversal de aprendizaje.",
    "p4": "La IE ANGEL MARIA PAREDES describe cinco acciones para articular el currículo con la comunidad: el desarrollo de proyectos pedagógicos contextualizados vinculados a la historia, la cultura y las problemáticas del entorno; el fortalecimiento del emprendimiento y el proyecto de vida mediante la Feria de Emprendimiento; la implementación de acciones ambientales a través del PRAE, jornadas ambientales y reciclaje; la realización de salidas pedagógicas y trabajo de campo; y el desarrollo de actividades culturales y de participación comunitaria que fortalecen la identidad territorial.",
    "p5": "La IE ANGEL MARIA PAREDES conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, el Equipo de Preescolar, los comités de área, el Equipo de Educación Inclusiva/NEE, el Consejo Estudiantil, el Consejo de Padres y la Personería Estudiantil para liderar la articulación curricular. Estos equipos se articulan mediante la planeación por áreas, los proyectos institucionales y el Consejo Académico, aunque se reconoce la necesidad de fortalecer la coordinación y definir con mayor claridad las responsabilidades. El seguimiento se apoya en actas de reunión, portafolios docentes, la plataforma JIGRA, la autoevaluación institucional anual y los reportes al MEN dentro del Plan de Mejoramiento Institucional.",
    "p6": "La IE ANGEL MARIA PAREDES considera que su toma de decisiones es participativa y democrática gracias a espacios como el Consejo Directivo, el Consejo Académico, el Consejo Estudiantil, el Consejo de Padres y la personería, aunque advierte que el reto es que las propuestas tengan mayor incidencia real y no se limiten a la consulta. Entre las acciones implementadas están las reuniones y asambleas de concertación, el fortalecimiento de los órganos del Gobierno Escolar, la formación en convivencia y ciudadanía, la aplicación de encuestas y consultas, y la socialización de decisiones y acuerdos. Los equipos que lideran estas estrategias incluyen el Gobierno Escolar, los distintos consejos, el comité de convivencia y la comisión de evaluación, con seguimiento mediante reuniones periódicas, elecciones estudiantiles y docentes, autoevaluación institucional y el Plan de Mejoramiento Institucional."
  },
  "141001003171": {
    "fileId": "1Mwpzj4z7WI2RwJv8hdvk_Gn4zX2Nvu-o",
    "institución": "LUIS IGNACIO ANDRADE",
    "p1": "La IE LUIS IGNACIO ANDRADE reconoce avances importantes frente a los retos del FEM 2025, especialmente en la consolidación de un currículo pertinente orientado al proyecto de vida de los estudiantes y en la generación de espacios de comunicación con las familias mediante reuniones de preinformes e informes y escuelas de padres. Sin embargo, señala como principal desafío lograr una participación más activa y permanente de las familias, dada la baja asistencia observada, y reconoce retos relacionados con la inclusión, la convivencia escolar y la permanencia estudiantil. También identifica como oportunidad de mejora la sistematización de experiencias pedagógicas significativas.",
    "p2": "La IE LUIS IGNACIO ANDRADE ha avanzado significativamente en la implementación de los tres grados de preescolar, contando con un equipo docente idóneo y en formación continua, y con una alianza con la Universidad Minuto de Dios para prácticas formativas en primera infancia. Ha fortalecido ambientes de aprendizaje y adoptado valoraciones descriptivas que reconocen los procesos de desarrollo de cada niño. Reconoce como retos fortalecer la cobertura frente a las condiciones demográficas del territorio y consolidar la participación de las familias más alla de la educación inicial.",
    "p3": "La IE LUIS IGNACIO ANDRADE reconoce que persiste una brecha significativa entre las exigencias del currículo tradicional y la realidad social, ambiental, cultural y productiva del territorio, pues la gestión curricular ha priorizado el cumplimiento de contenidos estandarizados por áreas. Propone consolidar un currículo contextualizado e incluyente construido con la participación de docentes, estudiantes, familias y actores comunitarios, articulando los estándares académicos con proyectos transdisciplinares sobre necesidades socioambientales y productivas.",
    "p4": "La IE LUIS IGNACIO ANDRADE describe tres acciones: la flexibilización y transformación de las programaciones curriculares priorizando aprendizajes esenciales y ajustes razonables para la diversidad de los estudiantes; la transversalización de proyectos institucionales como el Plan Lector, la Cátedra de Paz y las Competencias Ciudadanas; y la transformación de los procesos evaluativos mediante pruebas tipo Saber orientadas al desarrollo de competencias, más alla de la memorización de contenidos.",
    "p5": "La IE LUIS IGNACIO ANDRADE conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, comités de area, el Equipo de Educación Inclusiva y el Equipo de Autoevaluación Institucional. Estos se articulan mediante la planeación institucional y los comités de area, que integran los proyectos en las mallas curriculares, aunque se reconoce la necesidad de fortalecer el trabajo colaborativo para construir una visión curricular comun. El seguimiento se realiza mediante el análisis de resultados de Pruebas Saber e ICFES, actas de reunión de area y la plataforma JIGRA.",
    "p6": "La IE LUIS IGNACIO ANDRADE concluye que cuenta con mecanismos formales y democráticos para la toma de decisiones, mediante la conformación del Gobierno Escolar y la elección democrática de representantes, personero y contralor, aunque persisten dificultades como el bajo interés de algunos padres para participar y la limitada vinculación del sector productivo. Entre las acciones destaca la conformación y funcionamiento del Gobierno Escolar, la generación de espacios de participación y rendición de cuentas, el fortalecimiento de canales de comunicación institucional y la actualización participativa del PEI. Los equipos de trabajo incluyen el Gobierno Escolar y sus consejos, y el seguimiento se realiza mediante reuniones periódicas, elecciones estudiantiles y docentes, autoevaluación institucional anual e informes de gestión del Consejo Directivo."
  },
  "141001003341": {
    "fileId": "1LudhqTJNef5G9gDgmxSoTnNeb969e9LE",
    "institución": "INEM JULIAM MOTTA SALAS",
    "p1": "La IE INEM JULIAM MOTTA SALAS destaca avances en una educación pertinente e inclusiva mediante la diversificación curricular, modalidades vocacionales, prácticas pedagógicas innovadoras y alianzas con el SENA y universidades, además de avances ambientales con el PRAE y de inclusión mediante PIAR y DUA. Sin embargo, persisten dificultades estructurales de infraestructura, conectividad y recursos TIC, grupos numerosos y fricción entre el currículo y las Pruebas Saber, sumado a la falta de seguimiento a las conclusiones del FEM2025, por lo que se propone crear un comité de seguimiento al FEM.",
    "p2": "La IE INEM JULIAM MOTTA SALAS logró avances con la implementación del grado Jardín en la sede Candido, destinando recursos para adecuar espacios y contando con una docente nombrada provisionalmente. No obstante, el grado Prejardín aún no se ha consolidado por la baja demanda de matrícula y la presencia de hogares infantiles que atienden a esa población, por lo que se identifica la necesidad de mejorar la articulación con la Secretaria de Educación y los hogares de primera infancia.",
    "p3": "La IE INEM JULIAM MOTTA SALAS reconoce que sus currículos tienen fortalezas al conectar aprendizajes con la vida cotidiana mediante modalidades técnicas y proyectos transversales, pero considera que la pertinencia frente a las realidades sociales, culturales y productivas es limitada, con poca integración de saberes ancestrales y comunitarios y escasa presencia de expresiones culturales locales. También señala que las pruebas externas generan presiones que reducen la flexibilidad curricular.",
    "p4": "La IE INEM JULIAM MOTTA SALAS impulsa la actualización curricular por competencias revisando mallas y microcurriculos (Acción 1), fortalece la articulación con el SENA en áreas como turismo, software y agropecuaria (Acción 2), integra saberes locales y proyectos territoriales como preparación de alimentos tradicionales y agricultura escolar (Acción 3), promueve la innovación pedagógica con herramientas TIC como GeoGebra y Wordwall (Acción 4), y realiza seguimiento académico permanente a través del Consejo Académico, el Consejo Directivo y las Comisiones de Evaluación (Acción 5).",
    "p5": "La IE INEM JULIAM MOTTA SALAS conformó el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, comités de area, equipos de gestión académica y autoevaluación, el Consejo Estudiantil, el Consejo de Padres, la Personería y equipos específicos de proyectos, mejoramiento en pruebas Saber y articulación con el SENA. La institución reconoce que estos equipos trabajan de manera aislada por asignaturas, con esfuerzos interdisciplinarios puntuales pero sin continuidad ni estructura comun, por lo que se requiere una articulación más formal y sostenida. Como mecanismos de seguimiento se mencionan el análisis de Pruebas Saber e ICFES, el Consejo Académico, actas de reunión, la plataforma JIGRA, la autoevaluación institucional anual y los reportes al MEN.",
    "p6": "La IE INEM JULIAM MOTTA SALAS reconoce que cuenta con espacios formales de participación como el Consejo Directivo, el Consejo Académico, el Consejo Estudiantil, la Personería y la Contraloría, pero concluye que la participación no es plenamente efectiva porque los estudiantes se limitan a elegir representantes que a veces no ejercen sus funciones, los padres tienen baja asistencia y los egresados carecen de organización. Entre las acciones se destacan la divulgación mediante Inemitas TV (Acción 1), el fortalecimiento del Gobierno Escolar (Acción 2), la participación de familias en comisiones y comités (Acción 3), espacios de diálogo y revisión colectiva (Acción 4) y la promoción del liderazgo estudiantil (Acción 5). Los equipos conformados incluyen el Gobierno Escolar, los consejos directivo, académico y estudiantil, la personería y contraloría, el Consejo de Padres, el Comité Escolar de Convivencia y la Comisión de Evaluación, con mecanismos de seguimiento como reuniones periódicas de gobierno escolar, elecciones estudiantiles y docentes, y la autoevaluación institucional anual."
  },
  "141001003481": {
    "fileId": "15TSP4U1pmIhYUbwBzxUVX0vgZkoGNaTy",
    "institución": "MISAEL PASTRANA BORRERO",
    "p1": "La IE MISAEL PASTRANA BORRERO describió un avance paulatino y desigual en los retos del FEM 2025, con progresos claros en educación incluyente y respeto a la diversidad física, social, sexual, cultural y étnica, sin casos de discriminación reportados. Destacó mejoras en educación ambiental mediante huertas escolares y sensibilización sobre el cuidado del medio ambiente, así como en la atención a estudiantes con Plan Individual de Ajustes Razonables (PIAR). Señaló como reto pendiente la falta de docentes de apoyo suficientes frente al crecimiento de esta población y un mayor involucramiento de los padres de familia.",
    "p2": "La IE MISAEL PASTRANA BORRERO indicó que el avance en la implementación de nuevos grados de preescolar fue limitado, concentrándose en el fortalecimiento del grado de transición gracias a un rubro específico para material pedagógico y al ajuste en la distribución de aulas. Señaló que no se registraron avances concretos en la creación de los grados jardín o prejardín, debido fundamentalmente a la falta de infraestructura adecuada y de personal docente suficiente, y planteó como necesidad prioritaria la adecuación de la planta física y el aumento de la planta docente.",
    "p3": "La IE MISAEL PASTRANA BORRERO consideró que, en general, sus currículos son pertinentes con las realidades territoriales, sustentados en los estándares del MEN adaptados en el PEI y en proyectos pedagógicos transversales que vinculan a las familias y rescatan costumbres locales. Mencionó la incorporación progresiva de las cátedras de paz, afrocolombianidad y socioemocionalidad, aunque reconoció el reto de flexibilizar aún más el currículo y fortalecer la vinculación con el sector productivo.",
    "p4": "La IE MISAEL PASTRANA BORRERO describió cinco acciones para articular el currículo con la comunidad: la articulación de proyectos transversales y cátedras de paz, afrocolombianidad y socioemocionalidad con las planeaciones de aula; la revisión y ajuste anual del currículo, el PEI y los proyectos transversales; la flexibilización de estrategias pedagógicas y evaluativas según los ritmos de aprendizaje, incluyendo los PIAR; el desarrollo de proyectos de aula que vinculan a las familias; y la generación de espacios de diálogo con estudiantes y familias junto con capacitaciones docentes.",
    "p5": "La IE MISAEL PASTRANA BORRERO conformó comités de área organizados por sedes, jornadas o grados, junto con el Consejo Académico, el equipo de gestión, los docentes de apoyo, el comité de convivencia y las comunidades de aprendizaje. Explicó que estos equipos se articulan mediante reuniones periódicas semanales por área y grado, con un coordinador asignado por sede o jornada, reforzadas con capacitaciones internas y externas. Como mecanismos de seguimiento reportó reuniones de comisión, evaluación y consejo académico, actas por comité, cronogramas anuales y recolección de evidencias digitales, aunque reconoció la falta de retroalimentación continua y sistemática como una debilidad.",
    "p6": "La IE MISAEL PASTRANA BORRERO señaló una percepción mixta sobre la democracia institucional: reconoció que existe un gobierno escolar elegido democráticamente conforme a la Ley 115, pero que en la práctica la toma de decisiones se centra principalmente en el consejo directivo, con un papel más pasivo de los demás órganos. Describió acciones como la elección de representantes de grado y personero estudiantil, la escuela de padres, espacios de atención personalizada y asambleas del comité de convivencia. Reportó equipos como el Gobierno Escolar, los consejos directivo, académico y estudiantil, el comité de democracia y el comité de convivencia, junto con mecanismos de seguimiento como la elección democrática de representantes, reuniones periódicas de los consejos y actas y encuestas, aunque reconoció que estos mecanismos no siempre resultan suficientemente efectivos."
  },
  "141001003855": {
    "fileId": "1qKAIQ44c8elHLQNC2lupHzqtbCtdk5_U",
    "institución": "INSTITUTO TECNICO IPC ANDRES ROSA",
    "p1": "La IE INSTITUTO TECNICO IPC ANDRES ROSA ha consolidado durante seis años el ajuste de su plan curricular y la propuesta de áreas integradas, fortaleciendo el trabajo interdisciplinar y los centros de interés. El PRAE institucional responde a las necesidades ambientales del entorno y se ha avanzado en inclusión mediante el ajuste del Manual de Convivencia con enfoque de género, interculturalidad y antirracismo. A pesar del Comité de Búsquedas Activas, persisten dificultades de ausentismo y riesgo de deserción asociadas a la vulnerabilidad del contexto.",
    "p2": "La IE INSTITUTO TECNICO IPC ANDRES ROSA implementó el grado Jardín en una de sus sedes desde 2025, proyectando un nuevo grupo para 2026. Sin embargo, ha identificado una disminución en la tasa de natalidad del sector que afecta la conformación de los grupos de preescolar, llegando a disminuir el número de grados disponibles. El reto institucional es consolidar progresivamente jardín y prejardín haciendo seguimiento a las dinámicas de matrícula y población infantil.",
    "p3": "La IE INSTITUTO TECNICO IPC ANDRES ROSA considera que su currículo presenta avances importantes en pertinencia territorial, apoyado en la caracterización de estudiantes, la flexibilización curricular, las áreas integradas, los centros de interés y las modalidades técnicas. Incorpora aspectos de vulnerabilidad del entorno, convivencia y cultura huilense, así como formación técnica y emprendimiento para el proyecto de vida. Reconoce el reto de fortalecer la articulación transversal de problemáticas sociales, ambientales y culturales en todas las áreas.",
    "p4": "La IE INSTITUTO TECNICO IPC ANDRES ROSA describe cinco acciones: la flexibilización y ajuste curricular según necesidades e intereses de los estudiantes; el fortalecimiento de áreas integradas y transversalización; la consolidación de centros de interés y proyectos pedagógicos; el fortalecimiento de la formación técnica y el emprendimiento articulado al proyecto de vida; y la revisión y actualización de las prácticas de evaluación hacia procesos más formativos e integrales.",
    "p5": "La IE INSTITUTO TECNICO IPC ANDRES ROSA cuenta con numerosos equipos, entre ellos el Consejo Académico, el Consejo Directivo, equipos por nivel, comités de área, el Equipo de Educación Inclusiva, equipos de autoevaluación, calidad, seguimiento a egresados y una Mesa de Diálogo Currículo-Comunidad. Estos se articulan mediante espacios de trabajo colaborativo, comités, consejos y jornadas institucionales, con seguimiento a través de auditoría curricular frente a los DBA, análisis de Pruebas Saber, matrices de seguimiento curricular, autoevaluación institucional y mesas de calidad educativa territoriales.",
    "p6": "La IE INSTITUTO TECNICO IPC ANDRES ROSA considera que la toma de decisiones es participativa y democrática aunque con aspectos por fortalecer, señalando una incidencia limitada de estudiantes en decisiones curriculares y cierta centralización en directivos. Entre sus acciones destaca el fortalecimiento de las Escuelas de Familias, la capacitación de líderes estudiantiles, la ampliación de espacios de diálogo docente, la articulación entre equipos y comisiones, y el fortalecimiento de la participación de egresados. Los equipos que lideran estas estrategias incluyen el Gobierno Escolar y los distintos consejos y comités, con seguimiento mediante reuniones periódicas, autoevaluación institucional, el Plan de Mejoramiento Institucional y verificación por parte de la Secretaría de Educación."
  },
  "141001004061": {
    "fileId": "1oAJvIkTdb4Zr3VIkM5sORdBlNCKUOTjG",
    "institución": "CEINAR",
    "p1": "La IE CEINAR señala que ha contextualizado su propuesta educativa a partir del diagnóstico de necesidades de los estudiantes, articulando un hilo conductor institucional que culmina en proyectos de aula presentados en CEINARTE, y desarrolla la Cumbre para el liderazgo por la paz, el arte y la cultura junto con la organización comunal y entidades de gobierno. Entre las dificultades más relevantes menciona los tiempos para el trabajo interdisciplinar, el contacto con la comunidad, la vinculación de los padres de familia, el uso de recursos tecnológicos y el financiamiento de iniciativas docentes. Como retos plantea buscar alianzas con el sector productivo, fortalecer la apropiación de la filosofía institucional y promover el uso de recursos tecnológicos para acercar a las familias a los procesos formativos.",
    "p2": "La IE CEINAR indica que cuenta con recurso humano y espacio para atender preescolar, pero enfrenta baja cobertura de niños debido a la ubicación de la institución y a la desventaja frente a los CDI, que ofrecen alimentación y estadía prolongada con apoyo de un equipo interdisciplinar del que la IE carece. Reconoce que la experiencia con el grado jardín exige trabajar más con las familias para dar a conocer sus beneficios, y que no se ha registrado solicitud de cupos que permita abrir prejardín. Plantea como necesidad continuar promoviendo la matrícula por diferentes medios y solicitar inversión en infraestructura, recursos y capacitación al ente territorial.",
    "p3": "La IE CEINAR considera que sus currículos evidencian un esfuerzo por articular las realidades sociales, culturales y productivas del territorio a partir del diagnóstico de problemáticas escolares. Menciona como parte de ese esfuerzo el enfoque metodológico de investigación-creación, la articulación con el programa Escuelas que Aprenden de la Fundación Terpel para actualizar el currículo, la creación de espacios de integración familiar y experiencias como CEINARTE, Semillitas y la Cumbre.",
    "p4": "La IE CEINAR reporta cuatro acciones para articular el currículo con la comunidad: la articulación con la Fundación Terpel para fortalecer el liderazgo institucional y transformar el currículo y las prácticas pedagógicas; la vinculación de la investigación-creación como enfoque metodológico que integra el pensamiento científico y creativo; el desarrollo de proyectos institucionales como CEINARTE, la Cumbre y Semillitas; y la formulación de un hilo conductor institucional que permite proyectos pedagógicos integrados e interdisciplinares.",
    "p5": "La IE CEINAR conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, los comités de área, el Equipo de Educación Inclusiva/NEE, el Consejo Estudiantil, el Consejo de Padres, el Equipo de Proyectos Institucionales, el Comité de Proyectos de Grado y el Equipo Fundación Terpel. Estos se articulan mediante jornadas pedagógicas, formatos de documentación, el uso de redes sociales y espacios de socialización de planes de trabajo, en el marco de la resignificación del PEI. El seguimiento se realiza mediante la articulación con el PEI, la comparación histórica de resultados, bancos de evidencia digital, la autoevaluación institucional anual y la elaboración de informes de gestión.",
    "p6": "La IE CEINAR considera que su toma de decisiones sí es participativa y democrática, pues el Consejo Académico avala propuestas pedagógicas construidas colectivamente y el Consejo Directivo abre espacios de diálogo y debate, aunque reconoce falencias en la participación del consejo de padres. Entre las acciones destaca proyectos institucionales como la Cumbre, CEINARTE y La Minga que potencian la participación democrática, la vinculación interinstitucional con la comuna en el marco del POT, alianzas con universidades y el proyecto Escuela-Familia. Los equipos que lideran estas estrategias incluyen el Gobierno Escolar, el Comité Escolar de Convivencia, el Comité de Calidad y el equipo de entorno y sociedad que dinamiza la Cumbre, con seguimiento mediante reuniones periódicas, autoevaluación institucional, el Plan de Mejoramiento Institucional, rendición de cuentas e informes por proyecto."
  },
  "141001004312": {
    "fileId": "1wtDuaw47vcuFnEQVqEkUWrEz1PaudpL_",
    "institución": "HUMBERTO TAFUR CHARRY",
    "p1": "La IE HUMBERTO TAFUR CHARRY señaló avances en 2025 en inclusión, permanencia escolar, pertinencia de la formación y generación de nuevas oportunidades educativas. Destacó el fortalecimiento de una perspectiva educativa inclusiva, la implementación de centros de interés, la articulación con el SENA para formación técnica, la intensificación del inglés y la oferta de educación en calendario sabatino como respuesta a necesidades del contexto local. Planteó como reto consolidar estas estrategias y evaluar sistemáticamente sus resultados.",
    "p2": "La IE HUMBERTO TAFUR CHARRY reportó avances en la implementación de los grados Jardín y Transición, habiendo atendido durante 2025 a 119 estudiantes en transición y 40 en jardín. Señaló que aún falta fortalecer el seguimiento de los criterios de admisión conforme a los lineamientos del MEN, y que el principal reto pendiente es avanzar hacia la implementación del grado Prejardín, para lo cual se requiere mejorar la infraestructura y garantizar condiciones de accesibilidad para estudiantes con dificultades de movilidad.",
    "p3": "La IE HUMBERTO TAFUR CHARRY consideró que ha avanzado progresivamente hacia un currículo más pertinente con las realidades del territorio, especialmente a partir del programa CRECE, los centros de interés y el proyecto de Huertas Escolares, que permiten abordar de manera interdisciplinaria aspectos sociales, culturales, ambientales y productivos e incorporar saberes ancestrales. Reconoció que aún existen oportunidades de mejora para fortalecer la articulación entre las áreas del conocimiento y las dinámicas del contexto.",
    "p4": "La IE HUMBERTO TAFUR CHARRY describió cuatro acciones para articular el currículo con la comunidad: el fortalecimiento de los centros de interés; la articulación con el programa CRECE; una mayor articulación del currículo con las realidades sociales, culturales, ambientales y productivas de Neiva; y la integración de saberes ancestrales y regionales para fortalecer la identidad cultural.",
    "p5": "La IE HUMBERTO TAFUR CHARRY conformó el Consejo Académico, el Consejo Directivo, comités de área, el Equipo de Gestión Académica, el Consejo Estudiantil, el Consejo de Padres de Familia y la Personería Estudiantil, entre otros. Explicó que estos equipos se articulan mediante jornadas pedagógicas, el gobierno escolar y reuniones periódicas del equipo de gestión, partiendo del reconocimiento del contexto de los estudiantes mediante entrevistas con familias. Como mecanismos de seguimiento reportó el análisis de Pruebas Saber e ICFES, actas de reunión de área, rúbricas de observación de clase, plataformas de gestión académica y autoevaluación institucional anual.",
    "p6": "La IE HUMBERTO TAFUR CHARRY reconoció que cuenta con un Gobierno Escolar sólidamente constituido y con mecanismos formales de participación, pero que durante 2025 esta participación no siempre logró trascender hacia una incidencia efectiva en las decisiones, señalando que algunas decisiones unilaterales de la administración limitaron los espacios de deliberación colectiva. Entre sus acciones mencionó la participación de las familias en las Comisiones de Evaluación y Promoción, el fortalecimiento de la Escuela de Padres y de la Asociación de Padres de Familia, y la ampliación de espacios de diálogo con la comunidad educativa. Reportó equipos como el Gobierno Escolar, los consejos directivo, académico y estudiantil, la personería y contraloría estudiantil y la asociación de padres, junto con mecanismos de seguimiento como reuniones periódicas, elecciones estudiantiles, autoevaluación institucional anual y el Plan de Mejoramiento Institucional."
  },
  "141001004398": {
    "fileId": "1MBKAvLpv3hv2g2WnPc5_sOCoDkvZCbE1",
    "institución": "JOSE EUSTASIO RIVERA",
    "p1": "La IE JOSE EUSTASIO RIVERA destacó avances en inclusión y convivencia mediante currículos flexibles bajo el Diseño Universal para el Aprendizaje y los planes PIAR, así como en la consolidación de la trayectoria escolar continua desde educación inicial hasta grado 11. Resaltó la transversalización del proyecto ambiental PRAE, experiencias de lectura y escritura creativa, las Olimpiadas Matemáticas y avances en capacitación docente en TIC e inteligencia artificial. Señaló como desafíos pendientes la brecha digital y de infraestructura en las sedes de primaria, la necesidad de normas para el uso de dispositivos móviles y la consolidación de proyectos pedagógicos de aula articulados.",
    "p2": "La IE JOSE EUSTASIO RIVERA reportó la ampliación exitosa de la cobertura del grado Jardín en las sedes Ciudad Jardín y Eliseo Cabrera, consolidándose como referente en la comuna 5 al incluir prejardín, jardín y transición formalmente en su PEI, con un enfoque pedagógico centrado en el juego, el arte y la literatura. Señaló como desafíos pendientes la carencia de espacios físicos y sanitarios adecuados en las sedes Monserrate y Ciudad Jardín, y la baja demanda de matrícula en prejardín debido a la competencia de los hogares comunitarios del ICBF.",
    "p3": "La IE JOSE EUSTASIO RIVERA consideró que su currículo es pertinente porque aborda problemáticas del contexto real, con áreas de especialidad en la media orientadas a las demandas laborales de la región, la transversalización de la educación socioemocional y estrategias de lectura ligadas a la cátedra de paz y a un recorrido cultural por la ciudad (City Tour) para fortalecer el sentido de pertenencia. Reconoció, no obstante, la necesidad de seguir actualizando el PEI para que estas iniciativas dejen de ser esfuerzos aislados.",
    "p4": "La IE JOSE EUSTASIO RIVERA describió acciones para articular el currículo con la comunidad, entre ellas proyectos pedagógicos transversales contextualizados como el PRAE y una estrategia de lectura ligada a la cátedra de paz; la intensificación y actualización de la formación técnica en Ciencias Naturales, Inglés y Asistencia Administrativa; salidas pedagógicas y experiencias vivenciales en el territorio; y el trabajo articulado de comités que revisan periódicamente el PEI, el Manual de Convivencia y el SIEE.",
    "p5": "La IE JOSE EUSTASIO RIVERA conformó un amplio conjunto de equipos, entre ellos el Consejo Académico, el Consejo Directivo, equipos por nivel (preescolar, primaria, secundaria y media), el Equipo de Seguimiento a Egresados y el Equipo Dinamizador PTA. Explicó que estos equipos se articulan mediante el trabajo coordinado de comités que actualizan documentos institucionales clave, socializándolos con la comunidad antes de su aprobación por el consejo directivo, y mediante encuentros docentes periódicos. Como mecanismos de seguimiento reportó el análisis de Pruebas Saber e ICFES, actas de reunión de área, autoevaluación institucional anual y mesas de calidad educativa territoriales.",
    "p6": "La IE JOSE EUSTASIO RIVERA consideró que la toma de decisiones es parcialmente democrática, con canales estructurados de participación a través del Gobierno Escolar y la construcción colectiva del PEI, pero con desafíos como la falta de respuestas oportunas a las propuestas de la comunidad y deficiencias en el seguimiento. Entre sus acciones mencionó el fortalecimiento del Gobierno Escolar y la representación de estamentos, la vinculación corresponsable de las familias, la construcción participativa de documentos institucionales y la creación de veedurías comunitarias que hacen seguimiento a obras de infraestructura. Reportó equipos como el Gobierno Escolar y sus consejos, y mecanismos de seguimiento como reuniones periódicas, elecciones estudiantiles y el Plan de Mejoramiento Institucional."
  },
  "141001004452": {
    "fileId": "1bP68puKnujbUlCnojon7nJShDwOJ89hH",
    "institución": "EL LIMONAR",
    "p1": "La IE EL LIMONAR indica que ha avanzado en la política pública de educación inicial, capacitando al personal de primera infancia, mejorando la infraestructura (baterías sanitarias, aulas, espacios seguros) y ampliando la cobertura, pasando de solo transición y jardín hasta 2024 a contar en 2026 con los tres niveles: prejardín, jardín y transición. Destaca avances en las dimensiones del desarrollo integral de los niños (cognitiva, comunicativa, socioemocional, corporal y artistica), en concordancia con la normatividad vigente y promoviendo el trabajo corresponsable entre la institución, la familia y la comunidad.",
    "p2": "La IE EL LIMONAR reporta avances positivos en la implementación de los nuevos grados de preescolar: la sede Garabaticos ya cuenta con los tres grados (prejardín, jardín y transición), mientras que la sede Buenos Aires solo ofrece transición, con proyección de implementar jardín en 2027. Señala que ha fortalecido la propuesta pedagógica del nivel preescolar con base en los referentes del MEN y el modelo de Aprendizaje Significativo con enfoque humanista, organizada en cuatro periodos académicos y proyectos de aula.",
    "p3": "La IE EL LIMONAR considera que su currículo responde en buena medida a las necesidades del contexto de Neiva, integrando aspectos socioculturales, cívicos, productivos y ambientales, aunque reconoce la necesidad de seguir fortaleciendo la contextualización mediante temas como educación financiera, resolución de conflictos, desarrollo socioemocional y uso responsable de las TIC, apoyándose en proyectos transversales como Lectuvalores.",
    "p4": "La IE EL LIMONAR describe cinco acciones: los comités de area que ajustan los planes según los resultados de aprendizaje; los encuentros pedagógicos para compartir experiencias y estrategias; el Comité PEI, que orienta y da seguimiento al Proyecto Educativo Institucional; los proyectos transversales que articulan áreas y saberes con el contexto; y el proyecto LECTUVALORES, que fortalece competencias lectoras, valores y el uso responsable de las TIC mediante un semillero de TIC.",
    "p5": "La IE EL LIMONAR conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, los equipos de Preescolar y de Básica Primaria, los comités de area, el Equipo de Educación Inclusiva/NEE, el Equipo de Seguimiento a Egresados y el Consejo Estudiantil, entre otros. Estos se articulan mediante los comités de area, los encuentros pedagógicos, el Comité PEI, los proyectos transversales y Lectuvalores, generando espacios de diálogo y construcción colectiva. El seguimiento se realiza mediante el análisis de Pruebas Saber e ICFES, el Consejo Académico, portafolios docentes, la evaluación por matriz DOFA, la autoevaluación institucional anual y los reportes al MEN.",
    "p6": "La IE EL LIMONAR señala que la toma de decisiones es participativa y democrática, sustentada en el Gobierno Escolar y el PEI, con participación del Consejo Directivo, el Consejo Académico y los representantes estudiantiles, asi como en la construcción concertada del SIEE y el Manual de Convivencia. Entre sus acciones destaca la Escuela de Padres, las reuniones de preinforme de estudiantes, los convenios interinstitucionales (UIS, San Jorge, Comfamiliar, Banco de la República, SENA) y experiencias significativas que articulan escuela, familia y comunidad. Los equipos conformados incluyen el Gobierno Escolar, el Consejo Directivo, el Consejo Académico, el Consejo Estudiantil y el Comité Escolar de Convivencia, y el seguimiento se garantiza mediante reuniones periódicas, elecciones estudiantiles, la autoevaluación institucional, el Plan de Mejoramiento Institucional y el seguimiento al clima escolar."
  },
  "141001004720": {
    "fileId": "1pv64yHXKnXEtJ4kWa47sDXX3k2mpf22Y",
    "institución": "EDUARDO SANTOS",
    "p1": "La IE EDUARDO SANTOS reconoce avances progresivos en el cumplimiento de los retos del FEM 2025, especialmente en la atención integral a la Primera Infancia, destacando el compromiso docente para ampliar cobertura y fortalecer procesos pedagógicos. Sin embargo, la comunidad manifiesta inconformismo por el abandono y la falta de respuesta oportuna de la Secretaria de Educación y la Alcaldía, señalando una brecha entre las exigencias institucionales y las condiciones reales de infraestructura, recursos, tecnología, seguridad, aseo y PAE. También resalta la necesidad de más acompañamiento y capacitación en procesos como PIAR, DUA y COPAS. La IE considera fundamental que los retos vengan acompañados de inversión y seguimiento efectivo de las entidades responsables.",
    "p2": "La IE EDUARDO SANTOS ha avanzado progresivamente en la implementación de Prejardín y Jardín, ampliando la cobertura entre 2024 y 2026 y adecuando espacios para la Primera Infancia. Este proceso ha implicado nuevos retos institucionales y pedagógicos, con dificultades relacionadas con infraestructura, dotación, recursos pedagógicos, tecnología, seguridad, aseo y PAE. La comunidad reconoce el esfuerzo institucional pero expresa inconformismo por la insuficiente inversión y el limitado acompañamiento gubernamental, considerando necesario que la ampliación de cobertura vaya acompañada de condiciones dignas y pertinentes.",
    "p3": "La IE EDUARDO SANTOS considera que su currículo es pertinente aunque requiere seguir fortaleciendose, ya que desarrolla los contenidos nacionales pero los contextualiza según las características sociales, culturales y productivas del territorio. Los docentes destacan la importancia de mantener los aprendizajes fundamentales adaptándolos a la realidad local, recordando experiencias como el proyecto de elaboración de zapatos y proponiendo fortalecer el emprendimiento. También expresan preocupación porque las pruebas nacionales priorizan contenidos sin considerar suficientemente las particularidades territoriales.",
    "p4": "La IE EDUARDO SANTOS describe cinco acciones para articular el currículo con la comunidad: olimpiadas deportivas, culturales y académicas que canalizan el tiempo libre de los estudiantes; proyectos de promoción y prevención ambiental orientados al reciclaje y cuidado del agua; simulacros de pruebas a lo largo del año escolar; la caracterización de la comunidad educativa como insumo para actualizar el currículo; y capacitaciones docentes sobre las falencias en la implementación curricular.",
    "p5": "La IE EDUARDO SANTOS conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, comités de area, la Mesa Técnica de Inclusión, el Comité de Convivencia y el Gobierno Escolar, entre otros, para liderar las acciones curriculares. Estos equipos se articulan mediante conductos regulares, reuniones y espacios de planeación y socialización, donde los comités proponen y el Consejo Académico y Directivo analizan y aprueban las estrategias, buscando transversalizar los proyectos con las mallas curriculares. El seguimiento se realiza mediante actas de reunión de area, revisión de planes de aula y evaluaciones institucionales anuales, aunque se plantea fortalecer este proceso para que involucre a todo el equipo docente.",
    "p6": "La IE EDUARDO SANTOS considera que sí existen procesos participativos y democráticos a través del Gobierno Escolar, con participación de docentes, estudiantes, padres y sector productivo en el Consejo Directivo, aunque reconoce que la participación aún puede fortalecerse porque en ocasiones se limita a elegir representantes con poca deliberación previa. Entre las acciones desarrolladas se destacan estrategias de motivación estudiantil, el fortalecimiento de canales de comunicación por redes sociales, convocatorias a jornadas de mejoramiento institucional, el fortalecimiento del liderazgo estudiantil y la articulación con el proyecto Soy Constructor de mi Vida. Para liderar estas estrategias se apoya en los estamentos del Gobierno Escolar y en el Comité de Ciencias Sociales, y el seguimiento se realiza mediante la autoevaluación institucional anual y el Plan de Mejoramiento Institucional."
  },
  "141001005181": {
    "fileId": "19ORYPcXrI_O_7eqR20OwbZqWH-Xk4GtN",
    "institución": "JAIRO MORERA LIZCANO",
    "p1": "La IE JAIRO MORERA LIZCANO destaca avances impulsados por el cuerpo docente mediante proyectos ambientales (PRAE), de convivencia y la feria de emprendimiento, aunque la articulación del currículo con las dinámicas municipales sigue siendo incipiente. Señala el deterioro de la infraestructura tecnológica (laboratorios, tablets obsoletas, conectividad deficiente en la sede Guillermo Liévano) como freno a las metodologías creativas. Mantiene una política de puertas abiertas con enfoque de género y discapacidad, pero la atención integral es limitada por falta de personal especializado, y el Programa de Alimentación Escolar opera de forma parcial sin transporte escolar.",
    "p2": "La IE JAIRO MORERA LIZCANO registra un avance inicial con la apertura del grado Jardín en la sede Guillermo Liévano en 2026, con cobertura que pasó de 8 a 17 estudiantes matriculados. Sin embargo, no ha logrado abrir Prejardín por falta de condiciones físicas, y la sede carece de conectividad, equipos tecnológicos y espacios adaptados, presentando incluso riesgos estructurales como accesos solo por escaleras. También carece de personal de psicología y orientación especializado para la primera infancia.",
    "p3": "La IE JAIRO MORERA LIZCANO considera que su currículo no es pertinente con la realidad territorial, señalando una desconexión entre los contenidos oficiales, las pruebas estandarizadas y las dinámicas sociales, culturales y productivas de su comunidad, marcada por brechas socioeconómicas e informalidad laboral. Reconoce como fortaleza la vocación del cuerpo docente que flexibiliza el currículo de manera humanizante, y plantea la necesidad de transitar hacia el aprender haciendo e integrar tecnologías emergentes como la Inteligencia Artificial.",
    "p4": "La IE JAIRO MORERA LIZCANO reporta tres acciones: el diagnóstico de condiciones familiares, culturales y socioeconómicas de los estudiantes para adaptar contenidos y metodologías; la articulación de la identidad cultural y los aprendizajes prácticos mediante eventos tradicionales y el PRAE (huertas escolares y reciclaje); y el trabajo coordinado entre comités de área, Consejo Académico, proyectos de inclusión y convenios como el SENA, evaluado mediante el Plan de Mejoramiento Institucional.",
    "p5": "La IE JAIRO MORERA LIZCANO conformó equipos como el Consejo Académico, comités de área, la articulación con el SENA, el comité de seguimiento a la inclusión y grupos de proyectos transversales. Estos se articulan mediante reuniones del Consejo Académico y proyectos transversales como el PRAE y Eduderechos, aunque enfrentan limitaciones críticas de espacios y tiempos institucionales permanentes. El seguimiento se realiza mediante análisis de resultados de Pruebas Saber e ICFES, actas de reunión de área, autoevaluación institucional anual y reportes al MEN.",
    "p6": "La IE JAIRO MORERA LIZCANO señala que la toma de decisiones no es plenamente democrática, pues en la práctica predomina la autoridad directiva o de un grupo reducido, agravado por falta de comunicación, desinterés de padres y estudiantes, y dificultades para concertar documentos como el Manual de Convivencia. Entre sus acciones destaca el fortalecimiento del Gobierno Escolar y la Escuela de Padres, la construcción colectiva del PEI con proyectos contextualizados, y la articulación interinstitucional con entidades como ICBF, Personería e Inder Neiva. Los equipos que lideran estas estrategias incluyen el Gobierno Escolar y los distintos consejos, con seguimiento mediante reuniones periódicas, elecciones estudiantiles, autoevaluación institucional y rendición periódica de cuentas."
  },
  "141001005301": {
    "fileId": "1otzlHIhgVgIvMk-wsBONxx-3bd610_dj",
    "institución": "ENRIQUE OLAYA HERRERA",
    "p1": "La IE ENRIQUE OLAYA HERRERA identificó un avance parcial en la mayoría de los retos planteados en el FEM 2025. Señaló la necesidad de fortalecer la permanencia y continuidad académica de los estudiantes durante todo el año escolar, de mejorar los procesos de sistematización de información y experiencias pedagógicas, y de avanzar en la unificación de criterios pedagógicos y administrativos entre sedes. También reconoció dificultades en la recopilación y conservación de evidencias y registros de las actividades realizadas.",
    "p2": "La IE ENRIQUE OLAYA HERRERA reportó que ofrece Educación Inicial en los grados Jardín y Transición, con docentes capacitados en articulación con el MEN y la SEM, aunque el aula de Jardín aún requiere adecuación integral. Indicó baja demanda de estos grados por parte de las familias debido al corto tiempo de permanencia de los niños, dificultades de transporte y preferencia por servicios de cuidado externos de jornada completa. Señaló que el grado Prejardín no se encuentra activo actualmente por falta de matrícula, y planteó como reto mejorar los ambientes de aprendizaje y las estrategias de acercamiento a las familias.",
    "p3": "La IE ENRIQUE OLAYA HERRERA consideró que sus currículos actuales tienen en cuenta algunas realidades territoriales, pero que aún existen retos importantes para lograr una verdadera articulación entre la escuela y el contexto social, cultural y productivo. Planteó que el territorio debe entenderse no solo como espacio geográfico sino como escenario donde confluyen historia, cultura, saberes ancestrales y dinámicas productivas, y que un currículo pertinente debe partir del reconocimiento de esas particularidades.",
    "p4": "La IE ENRIQUE OLAYA HERRERA describió cinco acciones para articular el currículo con la comunidad: la articulación con el SENA en programas de asistencia administrativa y electrónica; el fortalecimiento de centros de interés propios de lectura, oralidad, preicfes, plan lector y una revista escolar; la participación en la estrategia Escuelas que Aprenden; el ajuste de los planes de área y de aula según las necesidades del contexto; y la revisión y actualización del PEI.",
    "p5": "La IE ENRIQUE OLAYA HERRERA conformó el Consejo Académico, los Comités de área, el Equipo de Gestión Académica y el Equipo de Calidad/Mejoramiento Continuo. Explicó que estos equipos se articulan mediante los comités de área que revisan los procesos curriculares, los comités de gestión que apoyan la planeación institucional, y los equipos vinculados a proyectos institucionales y culturales. Como mecanismos de seguimiento mencionó el análisis de Pruebas Saber e ICFES, actas de reunión de área, rúbricas de observación de clase, autoevaluación institucional anual y reportes al MEN, entre otros.",
    "p6": "La IE ENRIQUE OLAYA HERRERA consideró que existen mecanismos normativos de participación como el Gobierno Escolar y los consejos institucionales, pero que en la práctica estos espacios a menudo se limitan a cumplir requisitos administrativos, con baja participación de estudiantes y padres de familia. Entre sus acciones destacó la actualización participativa del PEI con apoyo de una alianza de escuelas que aprenden, charlas motivacionales y convocatorias por medios escritos y redes institucionales. Reportó numerosos equipos de trabajo (Gobierno Escolar, consejos directivo, académico y estudiantil, personero, contralor y consejo de padres, entre otros) y mecanismos de seguimiento como reuniones periódicas de los entes de gobierno escolar, elecciones estudiantiles, autoevaluación institucional anual y verificación por parte de la Secretaría de Educación."
  },
  "141001005866": {
    "fileId": "1Hbdp-EWIGhfgtouTUIK8r36qiY6ai2yN",
    "institución": "ATANASIO GIRARDOT",
    "p1": "La IE ATANASIO GIRARDOT reportó avances en jornada única y en la calidad del restaurante escolar en una de sus sedes, en el fortalecimiento del pensamiento crítico en primaria mediante el programa PTA/PFI 3.0, y en la atención a población diversa gracias a una mayor disposición docente hacia la inclusión. También destacó avances en educación ambiental mediante capacitaciones, jornadas de concientización y proyectos de reciclaje. Sin embargo, señaló debilidades en comunicación y evaluación institucional, estancamiento en la innovación pedagógica en varias sedes y limitaciones económicas que afectan la permanencia de algunos estudiantes.",
    "p2": "La IE ATANASIO GIRARDOT indicó que logró abrir los niveles de Jardín y Transición en la sede Guillermo Montenegro, donde antes no existían, gracias a la asignación de recursos para adecuar un aula y a la dotación de material pedagógico del gobierno nacional. No obstante, reconoció que el grado Prejardín no pudo consolidarse debido a la competencia de hogares infantiles privados con servicios más atractivos, a la insuficiencia de recursos que dejó obras físicas incompletas, y a la falta de organización y de criterios unificados entre el personal para manejar el nuevo nivel.",
    "p3": "La IE ATANASIO GIRARDOT consideró que sus currículos son solo parcialmente pertinentes con las realidades territoriales. Valoró su oferta técnica (Enfermería, Sistemas, Asistencia Administrativa, Contabilidad y Atención a la Primera Infancia) y la inclusión progresiva de proyectos transversales, pero señaló que prevalece un enfoque centrado en contenidos estandarizados y memorísticos, desactualización metodológica, poco uso práctico de TIC e inteligencia artificial, y una desconexión entre la malla curricular general y las problemáticas reales de cada sede.",
    "p4": "La IE ATANASIO GIRARDOT describió tres acciones para articular el currículo con la comunidad: el desarrollo de competencias y del proyecto de vida mediante la intensificación de inglés y simulacros de Pruebas Saber; el desarrollo cultural y participativo a través del Gobierno Escolar, la monitoría estudiantil, la Peña Cultural, el Festival de la Fruta y la Verdura y la celebración de la Huilensidad; y la implementación de proyectos transversales como el Pacto por el Buen Trato, campañas ambientales (PRAE) y el Plan Escolar de Movilidad.",
    "p5": "La IE ATANASIO GIRARDOT conformó como equipos de trabajo la Comisión de Evaluación y Promoción, los Comités de Área y el Equipo de Educación Inclusiva/NEE. Reconoció que falta articulación y liderazgo directivo para pensar colectivamente el currículo, pues durante 2026 no se ha convocado al Consejo Académico ni a otras instancias del gobierno escolar, por lo que la reflexión curricular surge principalmente desde los comités de área y los equipos de proyectos transversales. Como mecanismos de seguimiento mencionó el análisis de Pruebas Saber e ICFES, la comparación histórica de resultados, la tasa de deserción y reprobación, y la autoevaluación institucional anual.",
    "p6": "La IE ATANASIO GIRARDOT señaló que la toma de decisiones es formalmente democrática pero en la práctica parcial o meramente informativa, ya que el Consejo Directivo y el Consejo Académico solo se han reunido una vez en el año, y los estudiantes de educación inicial no participan en los procesos de democracia escolar. Entre sus acciones mencionó la creación de la página web institucional, la realización de debates escolares y la vinculación con la Personería Estudiantil, y la articulación del Consejo de Padres y las Escuelas de Padres. Reportó equipos como el Gobierno Escolar, el Consejo Estudiantil y la Comisión de Evaluación y Promoción, y reconoció que la mayoría de las mesas coinciden en que no existen mecanismos formales de seguimiento consolidados tras la etapa inicial de conformación del gobierno escolar."
  },
  "141001060336": {
    "fileId": "1NjDbZ8QtLHazn4jLZBlAw6fQCDzriZ9t",
    "institución": "RODRIGO LARA BONILLA",
    "p1": "La IE RODRIGO LARA BONILLA señala que avanzó en la actualización del PEI, la alineación normativa y convenios con el SENA y la USCO, destacando el Proyecto Ambiental Escolar (PRAE) y la atención inclusiva mediante PIAR. Sin embargo, reconoce serias barreras presupuestales, sobrecupo en aulas, falta de capacitación en discapacidad y problemas de infraestructura, además de percibir un currículo descontextualizado frente al proyecto pedagógico humanista.",
    "p2": "La IE RODRIGO LARA BONILLA indica que ha ampliado la cobertura a dos grados de prejardín y dos de jardín, con mallas curriculares enfocadas en el juego, el arte, la literatura y la exploración, dando continuidad a esta población en el grado transición. Reconoce que persisten vacíos en la dotación de material didáctico especializado, la adecuación de espacios físicos y la necesidad de equiparar los horarios con el servicio del PAE, por lo que considera imperativa una inversión económica y logística significativa.",
    "p3": "La IE RODRIGO LARA BONILLA considera que sus currículos presentan una pertinencia parcial, valorando positivamente la especialización técnica en Turismo y Diseño Gráfico, la intensificación en inglés y los proyectos culturales del Huila, pero reconoce desarticulación entre básica primaria y los grados superiores y la necesidad de adaptar más las mallas a las realidades sociales del entorno.",
    "p4": "La IE RODRIGO LARA BONILLA reporta tres acciones: la actualización curricular anual por áreas liderada por los comités de area para ajustar los planes de aula a las realidades de los grupos poblacionales atendidos; los Consejos Académicos ampliados, donde toda la comunidad docente participa en propuestas de transformación curricular; y el liderazgo en sostenibilidad ambiental desde el area de Ciencias Naturales para construir conciencia sobre el impacto humano en el medio ambiente.",
    "p5": "La IE RODRIGO LARA BONILLA conformó equipos como el Consejo Académico, la Comisión de Evaluación y Promoción, el Equipo de Preescolar, el Equipo de Básica Primaria y el Equipo de Evaluación Institucional. La articulación se da mediante reuniones del Consejo Académico, reuniones de docentes y equipos de area, análisis de resultados académicos, articulación de proyectos transversales y retroalimentación entre docentes y directivos. El seguimiento se realiza mediante auditoría curricular frente a los DBA y lineamientos del MEN, el análisis de Pruebas Saber e ICFES, el Consejo Académico y los comités de area o nucleos de formación.",
    "p6": "La IE RODRIGO LARA BONILLA considera que la toma de decisiones es participativa solo de manera parcial, pues aunque existen los espacios, se evidencian fallas en los canales de comunicación entre representantes y sus bases, además de apatía y ausencia de compromiso en la asistencia a los estamentos institucionales. Entre sus acciones menciona la trazabilidad documental mediante actas de seguimiento, elecciones ampliadas y representativas al inicio de cada año lectivo, e indicadores de calidad basados en la autoevaluación institucional. Los equipos de trabajo incluyen el Gobierno Escolar, el Consejo Directivo, el Consejo Académico, el Consejo Estudiantil, la Personería y Contraloría Estudiantil, y el seguimiento se garantiza mediante reuniones periódicas, elecciones estudiantiles, la autoevaluación institucional anual y el Plan de Mejoramiento Institucional."
  },
  "141001060441": {
    "fileId": "1GcrAExppZN7LvRagZS9Gu8rGEsgAeZ_R",
    "institución": "I.E. CLARETIANO GUSTAVO TORRES PARRA",
    "p1": "La IE CLARETIANO GUSTAVO TORRES PARRA señala que ha avanzado en el reconocimiento de su contexto mediante la unidad diagnóstica y la caracterización socioeconómica de los estudiantes, lo que permitió identificar necesidades y flexibilizar procesos. También se fortalecieron proyectos transversales, experiencias significativas, la intensificación del inglés y espacios de participación de la comunidad, aunque persisten dificultades relacionadas con conectividad, agua, sistema eléctrico y aseo que limitan la capacidad de respuesta institucional. La institución plantea como retos fortalecer la participación, mejorar el acompañamiento a los equipos de trabajo y consolidar mecanismos de seguimiento.",
    "p2": "La IE CLARETIANO GUSTAVO TORRES PARRA logró implementar el grado jardín en tres grupos, avanzando hacia un enfoque organizado por propósitos en lugar de dimensiones del desarrollo y fortaleciendo la valoración cualitativa y descriptiva de los estudiantes. Sin embargo, la institución aún no ha logrado abrir el grado prejardín, lo cual constituye uno de sus principales retos pendientes, junto con analizar la viabilidad de condiciones de jornada equivalentes entre jardín y transición en ambas jornadas.",
    "p3": "La IE CLARETIANO GUSTAVO TORRES PARRA considera que sus currículos presentan avances en pertinencia gracias a la caracterización de los estudiantes, el reconocimiento del territorio y los proyectos transversales, pero reconoce que aún es necesario fortalecer su articulación con las realidades sociales, culturales y productivas del contexto, asi como atender condiciones institucionales como la conectividad, el agua, el sistema eléctrico y el aseo que inciden en el aprendizaje. La institución concluye que la pertinencia curricular es un proceso en construcción que requiere seguir escuchando a la comunidad educativa.",
    "p4": "La IE CLARETIANO GUSTAVO TORRES PARRA fortaleció los proyectos transversales y las experiencias significativas articulando áreas del conocimiento con el contexto de los estudiantes (Acción 1), desarrollo actividades de reconocimiento y apropiación del territorio mediante experiencias pedagógicas y culturales (Acción 2), fortaleció la intensificación del inglés priorizando competencias comunicativas (Acción 3), implemento espacios de investigación, ciencia, tecnología y emprendimiento como la Feria de la Ciencia y salidas pedagógicas (Acción 4), y generó espacios de reflexión y revisión curricular por niveles para ajustar los currículos según las necesidades de los estudiantes (Acción 5).",
    "p5": "La IE CLARETIANO GUSTAVO TORRES PARRA conformó una amplia red de equipos, entre ellos el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, equipos de preescolar, básica primaria y básica secundaria y media, comités de area, el Equipo de Educación Inclusiva, el Equipo de Gestión Académica, el Equipo de Autoevaluación Institucional, el Consejo Estudiantil, el Consejo de Padres y la Personería Estudiantil. La articulación se da de forma progresiva mediante trabajo transversal e interdisciplinar entre áreas, proyectos y equipos, apoyado en reuniones de area y comisiones, aunque se requiere fortalecer la coordinación institucional y los tiempos de trabajo colaborativo. Como mecanismos de seguimiento se mencionan el análisis de resultados de Pruebas Saber e ICFES, el Consejo Académico, los comités de area, la articulación con el PEI, actas de reunión, portafolios docentes y la autoevaluación institucional anual, entre otros.",
    "p6": "La IE CLARETIANO GUSTAVO TORRES PARRA considera que la toma de decisiones es parcialmente participativa y democrática, ya que aunque existen órganos formales como el Gobierno Escolar y los distintos consejos, estos no siempre garantizan una incidencia efectiva de todos los actores, por lo que se plantea fortalecer una cultura de diálogo y comunicación de doble via. Entre las acciones desarrolladas se destacan espacios de diálogo como el Foro Educativo Institucional y el Foro de Derechos Humanos (Acción 1), el fortalecimiento de la participación de las familias mediante encuentros y entrevistas (Acción 2), la conformación de comisiones y equipos de trabajo (Acción 3), actividades culturales y productivas como el Festival de Comparsas y la Feria del Emprendimiento (Acción 4), y el fortalecimiento de alianzas con actores externos (Acción 5). Los equipos conformados incluyen el Gobierno Escolar, los consejos directivo, académico y estudiantil, la personería y contraloría estudiantil, el Consejo y la Asociación de Padres, el Comité Escolar de Convivencia y el Comité de Calidad, con mecanismos de seguimiento como reuniones periódicas de los entes de gobierno escolar, elecciones estudiantiles y docentes, la autoevaluación institucional anual y el ajuste permanente del PEI."
  },
  "241001000435": {
    "fileId": "1PnBD66qa8WiccJdFpwCqfM0wkO2uFTgO",
    "institución": "SAN ANTONIO DE ANACONIA",
    "p1": "La IE SAN ANTONIO DE ANACONIA, en su contexto rural, ha avanzado progresivamente en la construcción de una educación más pertinente y contextualizada, destacando la implementación progresiva de los tres grados de preescolar en las sedes San Antonio de Anaconia y Santa Librada. La comunidad, representada por la madre comunitaria Neyla Olaya, valora la organización de los niños por grupos de edad y la adecuación de los ambientes de aprendizaje, superando la sobrecarga que antes asumía un mismo docente con múltiples responsabilidades.",
    "p2": "La IE SAN ANTONIO DE ANACONIA avanzó progresivamente en la implementación de prejardín, jardín y transición, fortalecido mediante el diálogo con docentes, madres comunitarias y familias. Organizó a los niños según edades y etapas de desarrollo, contando ya con docentes destinados a educación inicial y ambientes adecuados, favoreciendo la socialización y autonomía mediante experiencias de juego, arte y literatura en lugar de un modelo centrado en contenidos.",
    "p3": "La IE SAN ANTONIO DE ANACONIA considera que sus currículos presentan avances en formación integral pero aún no responden plenamente a las particularidades sociales, culturales y productivas del territorio rural, señalando una orientación hacia referentes nacionales y pruebas estandarizadas que no siempre contemplan las necesidades comunitarias. Plantea avanzar hacia un currículo contextualizado, flexible y territorializado que reconozca la ruralidad, la cultura campesina y las prácticas productivas.",
    "p4": "La IE SAN ANTONIO DE ANACONIA describe cuatro acciones: el fortalecimiento de la formación integral mediante centros de interés y proyectos interdisciplinarios; la articulación de las áreas con el territorio incorporando elementos de ruralidad, producción agrícola y emprendimiento; el desarrollo de proyectos contextualizados que relacionan los conocimientos académicos con situaciones reales del entorno; y la integración de proyectos y experiencias significativas que convierten el territorio en escenario permanente de aprendizaje.",
    "p5": "La IE SAN ANTONIO DE ANACONIA conformó equipos como el Consejo Académico, el Consejo Directivo, equipos por nivel, comités de área, equipos de autoevaluación institucional, calidad y seguimiento a egresados, el Consejo Estudiantil y el Consejo de Padres. La articulación se desarrolla desde la formación integral y los centros de interés con trabajo interdisciplinario, y el seguimiento se realiza mediante auditoría curricular frente a los DBA, análisis de Pruebas Saber, actas de reunión de área, autoevaluación institucional y mesas de calidad educativa territoriales.",
    "p6": "La IE SAN ANTONIO DE ANACONIA considera que sí existe participación y democracia en la institución, con espacios legítimos como los Consejos Directivo y Académico y los personeros estudiantiles, aunque el desafío es visibilizar cómo esas decisiones se convierten en realidades concretas para la comunidad. Entre sus acciones destaca la creación de mesas comunitarias de co-creación del PEI, jornadas de rendición pública de cuentas pedagógicas, murales y boletines informativos comunitarios, y presupuestos participativos escolares. Los equipos que lideran estas estrategias incluyen el Gobierno Escolar y los distintos consejos, con seguimiento mediante reuniones periódicas, elecciones estudiantiles, autoevaluación institucional y el Plan de Mejoramiento Institucional."
  },
  "241001000486": {
    "fileId": "1XbbzAKu92Qvx-bO9dFuUNTur67SQ0-0U",
    "institución": "JAIRO MOSQUERA MORENO",
    "p1": "La IE JAIRO MOSQUERA MORENO señala que ha avanzado significativamente en el cumplimiento de los retos del FEM 2025, fortaleciendo acciones de calidad educativa, formación integral, inclusión, convivencia escolar y participación de las familias, articuladas con las políticas públicas territoriales y nacionales. Destaca un mayor compromiso institucional con la primera infancia y el preescolar mediante experiencias basadas en el juego, el arte y el entorno rural, y el fortalecimiento del trabajo colaborativo entre directivos, docentes, estudiantes y familias. También resalta acciones de seguimiento académico y convivencial y estrategias de acompañamiento a estudiantes con dificultades.",
    "p2": "La IE JAIRO MOSQUERA MORENO ha avanzado progresivamente en la ampliación de la atención a la primera infancia, con la apertura del grado Jardín en la sede San Jorge desde 2025 y la del nivel de Prejardín en 2026. Persisten falencias relacionadas con la adecuación y dotación de ambientes pedagógicos, la infraestructura física y el material didáctico especializado, por lo que se requiere mayor acompañamiento y recursos de los entes gubernamentales. La institución ve en estos nuevos grados una oportunidad para fortalecer la transición pedagógica hacia el grado Transición.",
    "p3": "La IE JAIRO MOSQUERA MORENO considera que sus currículos no son plenamente pertinentes con las realidades territoriales, señalando que la necesidad de responder a lineamientos y pruebas estandarizadas limita la flexibilidad curricular, especialmente en contextos rurales con población dispersa y aulas multigrado. Plantea que la pertinencia territorial no implica solo modificar contenidos sino fortalecer la capacidad institucional para integrar el contexto, avanzando hacia currículos flexibles y participativos.",
    "p4": "La IE JAIRO MOSQUERA MORENO describe cinco acciones: la contextualización de los aprendizajes relacionando contenidos con la vida cotidiana; la flexibilización curricular e inclusión mediante el DUA y los PIAR; el desarrollo de proyectos pedagógicos y centros de interés como semillas de vida y el club de astronomía y arqueología; el fortalecimiento de la identidad y saberes culturales de la región; y la participación y diálogo con la comunidad educativa mediante foros, aunque reconoce que la participación de los padres en estos espacios aún es limitada.",
    "p5": "La IE JAIRO MOSQUERA MORENO conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, equipos por nivel (Preescolar, Primaria, Secundaria y Media), el Equipo de Educación Inclusiva y el Equipo de Autoevaluación Institucional, entre otros. Estos se articulan mediante la coordinación entre el Consejo Académico, directivos y docentes, apoyándose en proyectos institucionales como PRAE y PESCC para integrar dimensiones ambientales, sociales y convivenciales, con la Comisión de Evaluación y Promoción haciendo seguimiento a los resultados. El seguimiento a las acciones se realiza mediante el análisis de resultados de Pruebas Saber e ICFES, actas de reunión de area, autoevaluación institucional anual y mesas de calidad educativa territoriales.",
    "p6": "La IE JAIRO MOSQUERA MORENO indica que ha avanzado hacia una mayor participación democrática desde 2025, fortaleciendo el papel del Personero y Contralor Estudiantil, aunque reconoce que la participación aún no es plenamente incluyente porque muchas decisiones se concentran en los órganos institucionales. Entre las acciones destaca el fortalecimiento de la representación estudiantil, la creación de espacios de diálogo y escucha, el fortalecimiento de la participación de las familias mediante la Escuela de Padres, proyectos pedagógicos con participación comunitaria y la rendición de cuentas con seguimiento a propuestas. Los equipos de trabajo incluyen el Gobierno Escolar y sus consejos, y el seguimiento se realiza mediante reuniones periódicas con los entes de gobierno escolar, elecciones estudiantiles y docentes, y la autoevaluación institucional anual."
  },
  "241001000664": {
    "fileId": "1xZqFBZF_mJkzaI_ux5Nlx9FXWRcLuB5A",
    "institución": "ROBERTO DURAN ALVIRA",
    "p1": "La IE ROBERTO DURAN ALVIRA reportó un avance altamente significativo en el cumplimiento de los retos del FEM 2025, cercano al 80% de las metas propuestas, mediante centros de interés, un macroproyecto institucional sobre saberes y desarrollo local sostenible, y proyectos pedagógicos transversales articulados con el entorno rural de Vegalarga. Destacó avances en educación para la paz, convivencia y resolución de conflictos, así como en la adecuación de infraestructura técnica y el acompañamiento de psicoorientación. También resaltó que la regularización del transporte y la alimentación escolar (PAE) fue determinante para reducir la deserción en las sedes veredales.",
    "p2": "La IE ROBERTO DURAN ALVIRA valoró unánimemente la apertura de los grados Prejardín y Jardín como un logro trascendental para la comunidad rural, con docentes especializados en educación temprana y una labor pedagógica centrada en el juego, el arte y la expresión corporal. Sin embargo, identificó barreras estructurales como hacinamiento en las aulas, falta de zonas de recreación y de biblioteca escolar adecuada, así como dificultades de transporte escolar seguro y baja corresponsabilidad de algunas familias.",
    "p3": "La IE ROBERTO DURAN ALVIRA consideró que sus currículos son pertinentes con las realidades territoriales, reflejado en la transversalización del macroproyecto institucional con la vocación agropecuaria del corregimiento de Vegalarga (café, ganadería, negocios verdes) y en la alianza con el SENA. Reconoció, no obstante, el reto de acortar la brecha entre las mallas curriculares estandarizadas nacionales y las necesidades campesinas.",
    "p4": "La IE ROBERTO DURAN ALVIRA describió cuatro acciones para articular el currículo con la comunidad: centros de interés y proyectos pedagógicos productivos como huertas escolares y emprendimientos agrícolas; el fortalecimiento de la articulación con el SENA hacia competencias agropecuarias, café y ganadería; estrategias de flexibilización y adaptación curricular para estudiantes con necesidades educativas especiales; y el desarrollo del macroproyecto institucional mediante salidas pedagógicas e investigación de campo en fincas de la región.",
    "p5": "La IE ROBERTO DURAN ALVIRA conformó numerosos equipos, entre ellos el Consejo Académico, el Consejo Directivo, comités de área, el Equipo de Educación Inclusiva/NEE, el Equipo de Autoevaluación Institucional y el Equipo de Sistematización de la Información. Explicó que estos equipos se articulan a partir de los horizontes del PEI y las líneas del macroproyecto institucional, aunque reconoció la necesidad de superar el funcionamiento aislado mediante un cronograma unificado. Como mecanismos de seguimiento reportó el análisis de resultados de Pruebas Saber, matrices de seguimiento curricular, portafolios docentes, evaluación por matriz DOFA y autoevaluación institucional anual, entre otros.",
    "p6": "La IE ROBERTO DURAN ALVIRA afirmó que la toma de decisiones es participativa y democrática, sustentada en el funcionamiento formal del Gobierno Escolar, canales de comunicación asertiva y la consulta permanente en el Consejo Directivo, la Junta de Padres y los Comités de Alimentación (PAE). Reconoció, sin embargo, que se requiere fortalecer la incidencia real de la comunidad frente a la asistencia pasiva de algunos acudientes y las barreras de transporte en veredas apartadas. Entre sus acciones mencionó el fortalecimiento de los órganos del Gobierno Escolar, el uso de canales digitales para mitigar barreras geográficas, jornadas de rendición pública de cuentas y la Escuela de Padres. Reportó equipos como el Gobierno Escolar y el Comité de Alimentación Escolar (CAE), junto con mecanismos de seguimiento como reuniones periódicas, rendición pública de cuentas y una encuesta con buzón de sugerencias."
  },
  "241001000711": {
    "fileId": "1LfIFnr123u9flXyIUMqRq3KitcZ5ndMJ",
    "institución": "AIPECITO",
    "p1": "La IE AIPECITO reconoce que la infraestructura no ha mejorado y en algunos casos ha desmejorado, con problemas como el area de lavado de ollas del restaurante escolar y salones de secundaria deteriorados, por lo que se plantea fortalecer la organización comunitaria para gestionar apoyos ante la Secretaria de Educación. En lo pedagógico sí se registran avances, como el area de Matemáticas relacionando funciones con la agricultura y el aporte de la formación del SENA en proyectos productivos agrícolas, mostrando una educación más pertinente aunque persisten retos de infraestructura.",
    "p2": "La IE AIPECITO transformó el currículo de preescolar hacia el trabajo por proyectos de aula que fortalecen la apropiación del contexto, la región y la comunidad, buscando superar la transmisión de contenidos con experiencias más dinámicas y participativas. Como avance concreto se vincularon los grados de prejardín y jardín en la sede La Union, ampliando la oferta de educación inicial en el territorio. La institución reconoce que estos cambios deben seguir acompañándose de recursos y formación permanente.",
    "p3": "La IE AIPECITO valora positivamente el currículo actual, aunque reconoce retos en contextualización, proyectos, disciplina y acompañamiento familiar. Una madre de familia resaltó que lo importante no es avanzar rápido en los contenidos sino garantizar su comprensión, respetando los diferentes ritmos de los estudiantes. Los propios estudiantes señalaron que metodologías distintas a la clase tradicional, como las pausas activas, facilitan el aprendizaje y que conocimientos de Matemáticas, Inglés, Ciencias Naturales y Sociales se aplican en su cotidianidad.",
    "p4": "La IE AIPECITO integra en la enseñanza las realidades sociales, ambientales y productivas del territorio, abordando temas como el cambio climático, el relieve, la biodiversidad, los cultivos de cafe y la huerta escolar para generar aprendizajes contextualizados. También incorpora metodologías activas y experiencias fuera del aula, como recorridos por la región, actividades recreativas y artisticas, que acercan los contenidos al entorno de los estudiantes. Adicionalmente desarrolla acciones de educación ambiental, como recolección y manejo de residuos solidos y jornadas de capacitación, para fortalecer la responsabilidad frente al cuidado del entorno.",
    "p5": "La IE AIPECITO conformó el Consejo Académico, el Consejo Directivo, comités de area, el Consejo de Padres de Familia y el Comité de Convivencia Escolar para liderar estas acciones. La articulación de estos equipos se apoya en una participación incluyente que vincula a estudiantes y familias en actividades como el FEM, un liderazgo cercano desde la rectoría y el trabajo coordinado reflejado en manifestaciones y actos culturales que conectan el territorio con el aula. Como mecanismos de seguimiento la institución menciona el propio FEM y la Junta de Acción Comunal (JAC).",
    "p6": "La IE AIPECITO considera que promueve una toma de decisiones participativa gracias a mecanismos como el Consejo Estudiantil, el Consejo Académico, el Consejo Directivo y la elección de personero y representantes, aunque reconoce que algunos padres no participan por timidez, desinterés o falta de tiempo en las reuniones. Entre las acciones para fortalecer la participación se propuso vincular formalmente a la Junta de Acción Comunal y lideres veredales a los proyectos institucionales, usar redes sociales para visibilizar necesidades de infraestructura, mejorar la comunicación y el cumplimiento de roles en los consejos, y que los representantes de cada grado recojan las solicitudes de sus compañeros. Los equipos conformados incluyen el Consejo Directivo, el Consejo Académico, el Consejo de Padres, el Comité Escolar de Convivencia, el Comité de Veeduría del PAE y comités de Gestión del Riesgo y Medio Ambiente, con mecanismos de seguimiento como el registro de acuerdos, la diversificación de canales informativos, la rendición de cuentas y la reafirmación del Gobierno Escolar."
  },
  "241001001890": {
    "fileId": "1KrWNeUPOH8EYM3Uz5COyTFlHYBgMohJ6",
    "institución": "CHAPINERO",
    "p1": "La IE CHAPINERO señala que la alta rotación de personal docente y la falta de acompañamiento presencial de la Secretaria de Educación al sector rural han afectado los avances curriculares. Aun asi, la institución ha hecho esfuerzos por construir un currículo acorde a la comunidad y ha desarrollado experiencias significativas que fomentan competencias investigativas, aunque estas dependen mucho de quien las lidera y se ven amenazadas por la rotación docente. También se destaca como avance la vinculación de la estrategia PTA PFI 3.0 al trabajo curricular desde lo socioemocional, aunque persiste el reto de atender el ausentismo escolar.",
    "p2": "La IE CHAPINERO cuenta con un aula de educación inicial en la sede Cabana con cinco estudiantes, apoyada por transporte escolar, pero las dificultades viales de la zona y la baja disposición de las familias a escolarizar a los niños antes de los cinco años limitan la ampliación de la cobertura. Como fortaleza se destaca el compromiso de algunas docentes que se han formado mediante el Diplomado de educación inicial. La institución identifica que de sus cinco experiencias significativas solo dos estan bien documentadas y visibilizadas, por lo que se requieren más espacios de socialización.",
    "p3": "La IE CHAPINERO reconoce que el territorio tiene fuerte influencia del cultivo de cafe y que cuenta con experiencias significativas relacionadas, pero señala que falta mayor flexibilización curricular para las épocas de cosecha, período en el cual aumenta el ausentismo escolar, lo que evidencia una pertinencia todavía parcial de los currículos frente a esta realidad productiva.",
    "p4": "La IE CHAPINERO orientó sus esfuerzos al ajuste y actualización de las mallas curriculares y el plan de estudios como primera acción. Como segunda acción creó e implementó ejes movilizadores con énfasis en deportes, artes e innovación tecnológica dentro de la jornada única. Como tercera acción fortaleció la estructura tecnológica de la institución para hacer más cercanos y motivantes los procesos pedagógicos en el aula.",
    "p5": "La IE CHAPINERO conformó el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, el Equipo de Autoevaluación Institucional, el Consejo de Padres de Familia y la Personería Estudiantil para liderar estas acciones. Las nuevas directivas identificaron como debilidad la falta de trabajo en equipo y de transferencia de experiencias significativas entre el personal, por lo que se plantea un plan de trabajo que active de manera formal los equipos ya constituidos documentalmente. Como mecanismo de seguimiento la institución señala la autoevaluación institucional anual.",
    "p6": "La IE CHAPINERO considera que la toma de decisiones es en parte participativa, ya que existen espacios para los padres de familia, pero estos se limitan principalmente al formalismo de entrega de informes académicos o llamados de atención, por lo que se plantea la necesidad de una estrategia más vinculante. Entre las acciones desarrolladas se mencionan actividades artisticas y culturales como la semana cultural y el dia de la huilensidad, jornadas de ornato y embellecimiento institucional con participación comunitaria, y el plan padrino liderado por docentes de sedes veredales para fortalecer la permanencia estudiantil. Los equipos conformados incluyen el Gobierno Escolar, el Consejo Directivo, el Consejo Estudiantil, la Personería, la Contraloría Estudiantil, el Consejo de Padres y el Comité Escolar de Convivencia, con mecanismos de seguimiento como elecciones estudiantiles, elección de docentes para los consejos directivo y académico, la autoevaluación institucional anual y el Plan de Mejoramiento Institucional."
  },
  "341001004559": {
    "fileId": "1jYunhg0Q7rmATdSlpWQ1SZwD8in0TWAW",
    "institución": "GABRIEL GARCIA MARQUEZ",
    "p1": "La IE GABRIEL GARCIA MARQUEZ señala como avance frente al FEM 2025 el replanteamiento de mallas curriculares y la generación de nuevos espacios para fortalecer la educación inicial mediante proyectos pedagógicos en el aula, reconociendo limitaciones en recursos didácticos e infraestructura. Destaca la importancia de las salidas de campo y pedagógicas para el aprendizaje significativo, aunque señala dificultades para desarrollar actividades con TIC. Propone conformar un comité de alerta temprana para hacer seguimiento a situaciones que afecten la permanencia y el bienestar estudiantil, y plantea diseñar actividades lúdicas que prevengan la deserción escolar.",
    "p2": "La IE GABRIEL GARCIA MARQUEZ reconoce que, pese a su compromiso con la estrategia municipal Primera Infancia Feliz y Protegida, la apertura oficial de Prejardín y Jardín se ha visto postergada por limitaciones críticas de infraestructura y por la insuficiencia de recursos didácticos y tecnológicos en sus sedes. Plantea como urgente un plan inmediato y progresivo que articule a la Secretaria de Educación, fondos de inversión pública y la comunidad educativa para adecuar ambientes físicos, baterías sanitarias y espacios lúdicos. Considera que solo mediante una gestión coordinada se lograra una oferta educativa incluyente y equitativa para la primera infancia.",
    "p3": "La IE GABRIEL GARCIA MARQUEZ considera que sus currículos son solo parcialmente pertinentes frente a las dinámicas territoriales, señalando que la presión por los resultados de las pruebas ICFES termina uniformando los contenidos y relegando la riqueza social, cultural y productiva de la región. Esta desconexión entre la teoría académica y el entorno genera un vacio en la formación estudiantil, y ante realidades económicas dificiles algunos estudiantes optan por abandonar sus estudios, lo que se traduce en deserción escolar.",
    "p4": "La IE GABRIEL GARCIA MARQUEZ describe cinco acciones: sensibilizar a los estudiantes frente a su entorno con actividades que los conecten con la realidad comunitaria; integrar lecturas sobre contexto y territorio; construir el proyecto de vida desde la básica primaria mediante orientación vocacional temprana; implementar el Aprendizaje Basado en Proyectos con enfoque en problemas reales del territorio; y diversificar las alternativas de proyecto de vida promoviendo emprendimiento y formación técnica, además de reactivar el plan lector con enfoque territorial.",
    "p5": "La IE GABRIEL GARCIA MARQUEZ conformó el Consejo Académico, comités de area, el comité de convivencia escolar y las áreas de gestión para liderar estas acciones. La articulación se da principalmente en los comités de area y de gestión durante las semanas de desarrollo institucional, aunque se reconoce que este trabajo aún resulta insuficiente porque la planeación se enfoca prioritariamente en el cumplimiento de los DBA y en la preparación para las pruebas ICFES, dejando de lado el enfoque territorial. El seguimiento se realiza mediante la plataforma de gestión académica JIGRA y el análisis de la eficiencia académica al finalizar cada período escolar.",
    "p6": "La IE GABRIEL GARCIA MARQUEZ concluye que la toma de decisiones es solo parcialmente democrática y participativa, pues aunque existen formalmente los órganos del Gobierno Escolar, en la práctica estos operan bajo un enfoque más instrumental que de incidencia real. Entre las acciones propuestas se destacan las Mesas Territoriales de Co-diseño Escuela-Comunidad con lideres de la Comuna 9 y microempresarios, un semillero de veedores estudiantiles para el control social del PAE, y Escuelas de Familias y Redes Comunales para la Infancia. Los equipos de trabajo incluyen el Gobierno Escolar, el Consejo Directivo, el Consejo Académico, el Consejo Estudiantil, el Personero Estudiantil, el Consejo de Padres y el Comité de Calidad, mientras que el informe reconoce que actualmente no se implementan acciones específicas de seguimiento a los gobiernos educativos democráticos, más alla de la autoevaluación institucional."
  },
  "441001002747": {
    "fileId": "18szh0sfJmPwRoLPd5UF7WfSmyqBoQvyb",
    "institución": "EL CAGUAN",
    "p1": "La IE EL CAGUAN señala que ha avanzado en el cumplimiento de algunos retos del FEM 2025 gracias al compromiso de la comunidad educativa, con prácticas pedagógicas pertinentes al contexto rural (turismo, agricultura, gastronomía) y avances en educación inclusiva y sostenibilidad ambiental, incluyendo recuperación de cuencas y siembra de arboles. También destaca la recontextualización del PEI, SIEE y Manual de Convivencia y la ampliación de articulaciones con entidades como la USCO, la Secretaria de Movilidad y el SENA. Sin embargo, reconoce que estos avances se han visto limitados por problemas de infraestructura y la inestabilidad de la rectoría, que han afectado la continuidad de procesos y la toma de decisiones.",
    "p2": "La IE EL CAGUAN, de carácter rural, indica que no ha logrado avanzar en la puesta en funcionamiento de los nuevos grados de prejardín y jardín, principalmente por limitaciones de infraestructura, mobiliario y recursos. Relata el caso de una docente asignada a estos grados que tuvo que ser reasignada por falta de espacios adecuados, debiendo improvisar un salon. La institución concluye que se requiere una inversión importante en infraestructura, contratación de personal y recursos para poder ofertar estos servicios.",
    "p3": "La IE EL CAGUAN considera que su currículo es pertinente con la realidad del territorio porque relaciona los aprendizajes con las necesidades sociales, culturales, productivas y ambientales de la comunidad, mencionando ejemplos como la sede La Gabriela, con población indígena y procesos de etnoeducación, y la sede Chapuro, con proyectos de emprendimiento vinculados a las actividades productivas locales.",
    "p4": "La IE EL CAGUAN describe tres acciones para articular el currículo con la comunidad: la revisión y actualización de los planes de area durante la semana institucional, dialogando sobre retos del contexto local, nacional y global; la adecuación de contenidos y competencias por parte de cada docente bajo la libertad de cátedra según las necesidades del aula; y la creación de comités de PEI, SIEE y Manual de Convivencia con participación voluntaria de docentes para la recontextualización normativa.",
    "p5": "La IE EL CAGUAN conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, los comités de area, el Equipo de Gestión Académica, el Consejo Estudiantil, el Consejo de Padres y la Personería Estudiantil. La articulación se da a partir de los equipos de area conformados según los perfiles de los docentes, el Consejo Académico como espacio de reflexión curricular y el equipo de reestructuración del PEI. El seguimiento se realiza mediante el análisis de resultados de Pruebas Saber e ICFES, el Consejo Académico, comités de area, actas de reunión, plataformas de gestión académica, la autoevaluación institucional anual y mesas de trabajo con padres y estudiantes.",
    "p6": "La IE EL CAGUAN considera que la toma de decisiones sí es democrática y participativa porque se brindan espacios de participación a toda la comunidad, más alla del gobierno escolar, como en la actualización del PEI, SIEE y Manual de Convivencia, aunque reconoce que es necesario fortalecer la formación en gobierno escolar y crear un canal de comunicación oficial. Entre sus acciones destaca la sensibilización y fortalecimiento del Gobierno Escolar, la socialización del PEI y el Manual de Convivencia al inicio de año, y la participación de las familias mediante reuniones de seguimiento. Los equipos de trabajo incluyen el Consejo de Padres, la Comisión de Evaluación y Promoción y otros comités de recontextualización del PEI, y el seguimiento se basa en la Ley 115 de 1994, con mecanismos como la Personería y Contraloría Estudiantil, el Concejo Estudiantil, el Consejo Directivo, el acompañamiento de la Secretaría de Educación y mecanismos de control ciudadano directo como asambleas."
  },
  "441001003433": {
    "fileId": "1DW6KkcLxb_gtAxAocinVFYiz1O-ik9CU",
    "institución": "SAN LUIS BELTRAN",
    "p1": "La IE SAN LUIS BELTRAN reconoce que ha dado pasos importantes hacia una educación más conectada con la realidad del territorio, fortaleciendo experiencias significativas, proyectos de aula, la huerta escolar y los proyectos ambientales PRAE. Sin embargo, señala que desde las familias surge la preocupación de que se necesita mayor apoyo y compromiso de todos los actores para que los proyectos contextualizados se mantengan en el tiempo, ya que algunos procesos se ven limitados por la falta de articulación con el PEI, los recursos o la continuidad.",
    "p2": "La IE SAN LUIS BELTRAN indica que realizó esfuerzos importantes para ampliar la atención a la primera infancia, gestionando una docente encargada de los grados prejardín y jardín, pero la respuesta no fue suficiente porque no se logró la cantidad de estudiantes necesaria para mantener la matrícula y la permanencia de la docente. Reconoce que muchas familias tienen a sus hijos vinculados a hogares de bienestar familiar, y que el reto es buscar alternativas y una mayor articulación entre la institución, las familias y las entidades de atención a la primera infancia.",
    "p3": "La IE SAN LUIS BELTRAN considera que la pertinencia del currículo depende de una participación más activa y real de toda la comunidad educativa, y que aunque existen mecanismos democráticos, la baja participación de familias, estudiantes y sectores productivos limita su construcción y enriquecimiento con propuestas diversas.",
    "p4": "La IE SAN LUIS BELTRAN describe tres acciones: el fortalecimiento del Gobierno Escolar como espacio para recoger las voces de estudiantes, docentes y familias en la planeación educativa; la generación de espacios de diálogo con familias y estudiantes aprovechando las reuniones de entrega de informes; y la promoción de una mayor participación de la comunidad en el Consejo Directivo, la Asociación de Padres, la Contraloría y la Personería.",
    "p5": "La IE SAN LUIS BELTRAN conformó equipos como el Consejo Académico, el Consejo Directivo, la Comisión de Evaluación y Promoción, los comités de area, el Consejo Estudiantil y la Personería Estudiantil. Estos se articulan mediante el Gobierno Escolar, el Consejo Académico, los comités de convivencia, la Escuela de Padres, la Asociación de Padres y los proyectos transversales. El seguimiento se realiza mediante el Consejo Académico, los comités de area, la articulación con el PEI, las actas de reunión, la autoevaluación institucional anual y los Foros Educativos Municipales.",
    "p6": "La IE SAN LUIS BELTRAN percibe una visión dividida sobre la toma de decisiones: aunque reconoce estructuras democraticas como el gobierno escolar, el consejo académico y la asociación de padres, considera que en la práctica la participación sigue siendo limitada por la baja participación de los padres y la necesidad de descentralizar decisiones hacia las sedes. Entre sus acciones destaca los foros educativos institucionales como espacios de diálogo, las reuniones y asambleas de padres de familia, y la rendición de cuentas como mecanismo de transparencia y participación. Los equipos de trabajo incluyen el Gobierno Escolar, el Consejo Directivo, el Consejo Académico, la Personería y Contraloría Estudiantil, el Consejo de Padres y el Comité Escolar de Convivencia, y el seguimiento se garantiza mediante reuniones periódicas, elecciones estudiantiles, la autoevaluación institucional anual y la actualización permanente del PEI."
  },
  "441001004839": {
    "fileId": "1z1WwRc3SVheo7IH6CHoS0Ujpbr6dhrxZ",
    "institución": "MARIA AUXILIADORA FORTALECILLAS",
    "p1": "La IE MARIA AUXILIADORA FORTALECILLAS reporta avances en educación pertinente mediante el fortalecimiento curricular, proyectos ligados al contexto local, protagonismo estudiantil y centros de interés; en inclusión, con ajustes razonables y modelos flexibles como Aceleración del Aprendizaje; y en gestión pedagógica, con la flexibilización de calendarios y el SIEE. Destaca los avances en educación inicial al formalizar en el PEI el ciclo II (prejardín, jardín y transición) y adecuar las aulas con mejores ambientes de aprendizaje. También resalta el fortalecimiento del trabajo con las familias para asegurar una comunicación fluida entre docentes, orientación y padres.",
    "p2": "La IE MARIA AUXILIADORA FORTALECILLAS registra un avance significativo con la apertura de prejardín y jardín, formalizando el ciclo II en el PEI y ampliando la oferta de cupos en el corregimiento de Fortalecillas. Ha transformado las aulas con mejor iluminación, cielo raso, aire acondicionado y parque infantil, y contempla a mediano plazo la construcción de salones propios y la compra de material didáctico especializado. El trabajo pedagógico se basa en la escucha activa, la observación sistemática y una evaluación cualitativa, con acompañamiento a las familias en la adaptación de los niños.",
    "p3": "La IE MARIA AUXILIADORA FORTALECILLAS reconoce avances hacia un currículo conectado con el territorio, mediante la actualización de planes de estudio, el fortalecimiento del enfoque Sistémico-Dialogante y proyectos PRAE, aunque su consolidación sigue siendo desigual. Señala como retos superar las prácticas aisladas y la falta de tiempo para la planeación interdisciplinar, y como saberes por integrar destaca la cultura e historia local, la economía basada en las achiras y el cuidado del río. Considera que el desafío prioritario es convertir el contexto local en un eje formativo permanente.",
    "p4": "La IE MARIA AUXILIADORA FORTALECILLAS describe cinco acciones: actualizar y contextualizar los planes de estudio liderados por el Consejo Académico; fortalecer proyectos transversales e interdisciplinarios que aborden situaciones reales del contexto; promover el diálogo de saberes reconociendo el conocimiento de las familias y la comunidad; fortalecer la investigación y el pensamiento crítico sobre las problemáticas del entorno; y ampliar la participación en la construcción curricular mediante encuestas y encuentros con la comunidad.",
    "p5": "La IE MARIA AUXILIADORA FORTALECILLAS conformó numerosos equipos, entre ellos el Consejo Académico, el Consejo Directivo, equipos por nivel, comités de area, el Comité Curricular Institucional, comités de cultura y el area de Orientación Escolar y Psicología. La articulación se dinamiza en el Consejo Académico, los proyectos transversales y el diálogo de saberes locales, aunque el principal reto es optimizar los tiempos de planeación docente y transparentar el seguimiento de los comités. El seguimiento se realiza mediante auditoría curricular frente a los DBA, análisis de resultados de pruebas, matrices de seguimiento curricular y reportes al MEN.",
    "p6": "La IE MARIA AUXILIADORA FORTALECILLAS cuenta con una estructura formal de participación (Gobierno Escolar, consejos, personería y comités), pero reconoce debate sobre su capacidad real de decisión, pues algunas voces señalan que las decisiones estrategicas se concentran en la directiva. Propone una ruta de Participar para decidir en cinco pasos: escuchar, priorizar, tramitar, decidir mediante acuerdos vinculantes y retroalimentar a la comunidad. Entre las acciones destaca fortalecer el Gobierno Escolar y sus comités, realizar asambleas y espacios de diálogo, e implementar consultas comunitarias mediante encuestas y buzones de sugerencias; los equipos incluyen el Gobierno Escolar y sus consejos, y el seguimiento se apoya en la autoevaluación institucional anual y el Plan de Mejoramiento Institucional."
  }
};

/** URL de Drive para ver el Informe Ejecutivo real de una IE, o "" si no existe el archivo. */
function _urlInformeEjecutivoIE_(idIE) {
  var r = RESUMENES_PREPARACION_IE_[String(idIE || "").trim()];
  if (!r || !r.fileId) return "";
  return "https://drive.google.com/file/d/" + r.fileId + "/view";
}

/**
 * Preparación de una sola IE, lista para pintar en pantalla: si el grupo
 * ya guardó algo en PreparacionIE se usa eso; si no, cada pregunta parte
 * del resumen sugerido (RESUMENES_PREPARACION_IE_) como texto inicial
 * editable — nunca se envía nada sin que la IE lo revise (ENVIADO
 * siempre arranca en "NO").
 */
function obtenerPreparacionIE(idGrupo, idIE) {
  idGrupo = String(idGrupo || "").trim();
  idIE = String(idIE || "").trim();
  var ie = obtenerInstitucionesDelGrupo(idGrupo).find(function (i) {
    return i.idIE === idIE;
  });
  if (!ie) return null;

  var hoja = obtenerHoja_(HOJA_PREPARACION_IE_, cabecerasPreparacionIE_());
  var mapa = obtenerMapaCabeceras_(hoja);
  var fila = buscarFilaPorColumna_(hoja, mapa, "CLAVE", _clavePreparacion_(idGrupo, idIE));
  var guardada = fila === -1 ? null : leerFilaComoObjeto_(hoja, fila, mapa);

  var sugerido = RESUMENES_PREPARACION_IE_[idIE] || null;
  var respuestas = {};
  PREGUNTAS_PREPARACION_.forEach(function (p) {
    if (guardada && guardada[p.clave]) {
      respuestas[p.clave] = String(guardada[p.clave]);
    } else {
      respuestas[p.clave] = sugerido ? String(sugerido[p.clave.toLowerCase()] || "") : "";
    }
  });

  return {
    // "(Informe Ejecutivo (IE)" -> "(Informe Ejecutivo de la <nombre real
    // de la institución>": las ayudas de PREGUNTAS_PREPARACION_ llevan el
    // marcador {{IE}}, sustituido aquí por el nombre real de esta IE.
    preguntas: preguntasPreparacionConNombreIE_(ie.institucion),
    respuestas: respuestas,
    responsable: guardada ? String(guardada.RESPONSABLE || "") : "",
    enviado: guardada ? String(guardada.ENVIADO || "") === "SI" : false,
    fechaEnvio: guardada && guardada.FECHA_ENVIO ? String(guardada.FECHA_ENVIO) : "",
    urlInformeEjecutivo: _urlInformeEjecutivoIE_(idIE)
  };
}

/** PREGUNTAS_PREPARACION_ con el marcador {{IE}} de cada ayuda sustituido por el nombre real de la institución. */
function preguntasPreparacionConNombreIE_(nombreIE) {
  return PREGUNTAS_PREPARACION_.map(function (p) {
    return {
      clave: p.clave,
      titulo: p.titulo,
      ayuda: p.ayuda.replace(/\{\{IE\}\}/g, nombreIE || "esta institución")
    };
  });
}

/** Autoguardado de las 6 respuestas + responsable — mismo patrón que guardarSesion1 (Sesion1.gs). */
function guardarPreparacionIE(idGrupo, tokenSesion, dispositivoId, idIE, responsable, respuestas) {
  idGrupo = String(idGrupo || "").trim();
  if (!sesionActivaPorIdGrupo_(idGrupo, dispositivoId, tokenSesion)) {
    return { ok: false, codigo: "SESION_NO_AUTORIZADA", mensaje: "Esta sesión ya no está activa en este dispositivo." };
  }
  return _guardarPreparacionIEInterno_(idGrupo, idIE, responsable, respuestas);
}

/**
 * Escritura real, sin verificación de sesión — la usan tanto
 * guardarPreparacionIE (sesión de grupo, con código) como el acceso de
 * invitado (Invitados.gs, sin código, autenticado con su propio token de
 * un solo uso). Ambos caminos validan primero, cada uno a su manera, que
 * quien llama tiene permiso; esta función solo hace el UPSERT.
 */
function _guardarPreparacionIEInterno_(idGrupo, idIE, responsable, respuestas) {
  idGrupo = String(idGrupo || "").trim();
  idIE = String(idIE || "").trim();
  var perteneceAlGrupo = obtenerInstitucionesDelGrupo(idGrupo).some(function (ie) {
    return ie.idIE === idIE;
  });
  if (!perteneceAlGrupo) return { ok: false, mensaje: "Esa institución no pertenece a este grupo." };

  var datos = {
    ID_GRUPO: idGrupo,
    ID_IE: idIE,
    RESPONSABLE: String(responsable || "").trim(),
    ULTIMA_ACTUALIZACION: new Date()
  };
  PREGUNTAS_PREPARACION_.forEach(function (p) {
    datos[p.clave] = String((respuestas || {})[p.clave] || "");
  });

  return conLock_(function () {
    upsertFila_(HOJA_PREPARACION_IE_, cabecerasPreparacionIE_(), "CLAVE", _clavePreparacion_(idGrupo, idIE), datos);
    return { ok: true };
  }, 10000);
}

/**
 * Envío definitivo de los aportes de preparación de una IE: a partir de
 * este momento aparecen en la sección de socialización de Sesión 1 (spec:
 * "enviar aportes de la IE (nombre) para socializar oralmente con el
 * grupo (número) y la comunidad asistente"). Requiere que la IE tenga al
 * menos una respuesta no vacía.
 */
function marcarPreparacionEnviada(idGrupo, tokenSesion, dispositivoId, idIE) {
  idGrupo = String(idGrupo || "").trim();
  if (!sesionActivaPorIdGrupo_(idGrupo, dispositivoId, tokenSesion)) {
    return { ok: false, codigo: "SESION_NO_AUTORIZADA", mensaje: "Esta sesión ya no está activa en este dispositivo." };
  }
  return _marcarPreparacionEnviadaInterno_(idGrupo, idIE);
}

/** Escritura real, sin verificación de sesión — ver comentario de _guardarPreparacionIEInterno_. */
function _marcarPreparacionEnviadaInterno_(idGrupo, idIE) {
  idGrupo = String(idGrupo || "").trim();
  idIE = String(idIE || "").trim();
  var perteneceAlGrupo = obtenerInstitucionesDelGrupo(idGrupo).some(function (ie) {
    return ie.idIE === idIE;
  });
  if (!perteneceAlGrupo) return { ok: false, mensaje: "Esa institución no pertenece a este grupo." };

  var hoja = obtenerHoja_(HOJA_PREPARACION_IE_, cabecerasPreparacionIE_());
  var mapa = obtenerMapaCabeceras_(hoja);
  var fila = buscarFilaPorColumna_(hoja, mapa, "CLAVE", _clavePreparacion_(idGrupo, idIE));
  var tieneAlgo = false;
  if (fila !== -1) {
    var guardada = leerFilaComoObjeto_(hoja, fila, mapa);
    tieneAlgo = PREGUNTAS_PREPARACION_.some(function (p) {
      return String(guardada[p.clave] || "").trim() !== "";
    });
  }
  if (!tieneAlgo) {
    return { ok: false, mensaje: "Responda al menos una pregunta antes de enviar." };
  }

  return conLock_(function () {
    upsertFila_(HOJA_PREPARACION_IE_, cabecerasPreparacionIE_(), "CLAVE", _clavePreparacion_(idGrupo, idIE), {
      ID_GRUPO: idGrupo,
      ID_IE: idIE,
      ENVIADO: "SI",
      FECHA_ENVIO: new Date()
    });
    return { ok: true };
  }, 10000);
}

/**
 * Todos los aportes ya enviados del grupo, listos para la sección de
 * socialización de Sesión 1 — un párrafo con título por cada pregunta que
 * la IE haya diligenciado (las vacías se omiten, nunca se muestra un
 * párrafo vacío).
 */
function obtenerPreparacionesEnviadasGrupo(idGrupo) {
  idGrupo = String(idGrupo || "").trim();
  var hoja = obtenerHoja_(HOJA_PREPARACION_IE_, cabecerasPreparacionIE_());
  var filas = leerFilasComoObjetos_(hoja);
  var porIE = {};
  filas.forEach(function (f) {
    if (String(f.ID_GRUPO || "").trim() !== idGrupo) return;
    if (String(f.ENVIADO || "") !== "SI") return;
    porIE[String(f.ID_IE || "").trim()] = f;
  });

  var instituciones = obtenerInstitucionesDelGrupo(idGrupo);
  var resultado = [];
  instituciones.forEach(function (ie) {
    var fila = porIE[ie.idIE];
    if (!fila) return;
    var secciones = [];
    PREGUNTAS_PREPARACION_.forEach(function (p) {
      var texto = String(fila[p.clave] || "").trim();
      if (texto) secciones.push({ clave: p.clave, titulo: p.titulo, texto: texto });
    });
    if (!secciones.length) return;
    resultado.push({
      idIE: ie.idIE,
      institucion: ie.institucion,
      responsable: String(fila.RESPONSABLE || "").trim(),
      secciones: secciones
    });
  });
  return resultado;
}
